    private void BuildConfirmBar()
    {
        confirmBar = new GameObject("ConfirmBar");
        confirmBar.transform.SetParent(mainCanvas.transform, false);
        var rect = confirmBar.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.5f, 0);
        rect.anchorMax = new Vector2(0.5f, 0);
        rect.pivot = new Vector2(0.5f, 0);
        rect.anchoredPosition = new Vector2(0, DS.ConfirmBottomY);
        rect.sizeDelta = new Vector2(DS.ConfirmBtnSize * 2 + DS.ConfirmGap, DS.ConfirmBtnSize);

        var confBtn = MakeIconButton(confirmBar.transform, "ConfirmBtn",
            DS.ConfirmBtnSize, DS.Accent, Color.white, "check",
            -(DS.ConfirmBtnSize * 0.5f + DS.ConfirmGap * 0.5f), 0);
        AddShadow(confBtn.gameObject, DS.ShadowStrong, 8f);
        confBtn.onClick.AddListener(OnConfirmPlace);

        var cancBtn = MakeIconButton(confirmBar.transform, "CancelBtn",
            DS.ConfirmBtnSize, DS.GlassStrong, DS.Danger, "x",
            DS.ConfirmBtnSize * 0.5f + DS.ConfirmGap * 0.5f, 0);
        AddShadow(cancBtn.gameObject, DS.ShadowStrong, 8f);
        cancBtn.onClick.AddListener(OnCancelPlace);
    }

    private void SetConfirmBarVisible(bool v)
    {
        if (confirmBar) confirmBar.SetActive(v);
    }

    private void EnterPreviewMode()
    {
        if (isPreviewMode) return;
        isPreviewMode = true;
        lastPoseValid = false;
        lastValidPlane = null;
        previewIsStable = false;
        previewStableTime = 0f;
        if (potPrefabs == null || selectedPotIndex >= potPrefabs.Length) return;
        var prefab = potPrefabs[selectedPotIndex];
        if (!prefab) return;
        previewGhost = Instantiate(prefab);
        previewGhost.name = "PreviewGhost";
        float realH = GetRealHeightForIndex(selectedPotIndex);
        if (realH > 0.01f) NormalizeObjectToHeightCm(previewGhost, realH);
        previewGhost.transform.localScale *= defaultScale;
        SetGhostTransparency(previewGhost, 0.45f);
        foreach (var col in previewGhost.GetComponentsInChildren<Collider>()) Destroy(col);
        previewGhost.SetActive(false);
        SetConfirmBarVisible(true);
        if (bottomBar) bottomBar.SetActive(false);
    }

    private void ExitPreviewMode()
    {
        isPreviewMode = false;
        lastPoseValid = false;
        lastValidPlane = null;
        previewIsStable = false;
        if (previewGhost) Destroy(previewGhost);
        previewGhost = null;
        SetConfirmBarVisible(false);
        if (bottomBar) bottomBar.SetActive(true);
    }

    private void UpdatePreviewGhost()
    {
        if (!isPreviewMode || !previewGhost) return;

        // Per-frame: try to find a valid plane from screen center
        previewFoundThisFrame = false;
        Vector2 center = new Vector2(Screen.width * 0.5f, Screen.height * 0.5f);
        if (raycastManager.Raycast(center, s_Hits, TrackableType.PlaneWithinPolygon))
        {
            for (int i = 0; i < s_Hits.Count; i++)
            {
                if (ValidatePreviewCandidate(s_Hits[i], out ARPlane plane))
                {
                    lastValidPose = s_Hits[i].pose;
                    lastValidPlane = plane;
                    lastPoseValid = true;
                    previewFoundThisFrame = true;
                    break;
                }
            }
        }

        // If nothing found this frame, reset stability and hide ghost
        if (!previewFoundThisFrame)
        {
            lastPoseValid = false;
            lastValidPlane = null;
            previewIsStable = false;
            previewGhost.SetActive(false);
            return;
        }

        // Show and position ghost
        previewGhost.SetActive(true);
        Vector3 targetPos = lastValidPose.position + new Vector3(0, yOffset, 0);
        previewGhost.transform.position = targetPos;
        if (faceCameraOnPlace && arCamera)
        {
            Vector3 dir = arCamera.transform.position - lastValidPose.position;
            dir.y = 0;
            if (dir.sqrMagnitude > 0.001f)
                previewGhost.transform.rotation = Quaternion.LookRotation(-dir.normalized) * Quaternion.Euler(prefabRotationOffsetEuler);
        }
        GroundPreviewGhost();

        // Stability / dwell tracking
        if (Vector3.Distance(targetPos, previewLastStablePos) > JITTER_THRESHOLD)
        {
            previewLastStablePos = targetPos;
            previewStableTime = Time.unscaledTime;
            previewIsStable = false;
        }
        else if (!previewIsStable && Time.unscaledTime - previewStableTime >= DWELL_TIME)
        {
            previewIsStable = true;
        }
    }

    /// <summary>Lenient validation for preview — allows Limited tracking planes.</summary>
    private bool ValidatePreviewCandidate(ARRaycastHit hit, out ARPlane plane)
    {
        plane = null;
        if (planeManager == null) return false;
        plane = planeManager.GetPlane(hit.trackableId);
        if (plane == null) return false;
        if (plane.alignment != PlaneAlignment.HorizontalUp) return false;
        // Accept Limited tracking for preview (more forgiving)
        if (plane.trackingState == TrackingState.None) return false;
        var c = plane.classification;
        if (c == PlaneClassification.Wall || c == PlaneClassification.Ceiling ||
            c == PlaneClassification.Door || c == PlaneClassification.Window) return false;
        // Use actual polygon area instead of extents
        if (ComputePolygonArea(plane) < 0.04f) return false;
        if (!IsPointInsidePlane(plane, hit.pose.position)) return false;
        return true;
    }

    private void GroundPreviewGhost()
    {
        if (!previewGhost) return;
        Physics.SyncTransforms();
        Bounds b = GetWorldBoundsFromRenderers(previewGhost);
        if (b.size == Vector3.zero) return;
        float surfaceY = lastValidPose.position.y + yOffset;
        previewGhost.transform.position += new Vector3(0f, surfaceY - b.min.y, 0f);
    }

    private void OnConfirmPlace()
    {
        if (!isPreviewMode || !lastPoseValid || !previewFoundThisFrame) return;
        if (!previewIsStable) return;
        if (lastValidPlane == null || lastValidPlane.trackingState != TrackingState.Tracking)
        { ShowToast("Surface lost", null, false); return; }

        // Anti-overlap: check distance to all existing pots
        Bounds ghostBounds = GetWorldBoundsFromRenderers(previewGhost);
        float ghostRadius = Mathf.Max(ghostBounds.extents.x, ghostBounds.extents.z);
        foreach (var existing in spawnedObjects)
        {
            if (!existing) continue;
            Bounds eb = GetWorldBoundsFromRenderers(existing);
            float existRadius = Mathf.Max(eb.extents.x, eb.extents.z);
            float minDist = ghostRadius + existRadius + MIN_POT_SPACING;
            Vector3 dv = lastValidPose.position - eb.center;
            dv.y = 0;
            if (dv.magnitude < minDist)
            { ShowToast("Too close to another pot", null, false); return; }
        }

        // Footprint support: probe points around the base must all be inside the plane
        if (!IsFootprintSupported(lastValidPlane, lastValidPose.position, ghostRadius))
        { ShowToast("Surface too small", null, false); return; }

        PlaceObjectAtPose(lastValidPose, lastValidPlane);
        ExitPreviewMode();
    }

    private void OnCancelPlace() { ExitPreviewMode(); }

    private void SetGhostTransparency(GameObject obj, float alpha)
    {
        foreach (var r in obj.GetComponentsInChildren<Renderer>())
        {
            foreach (var mat in r.materials)
            {
                Color c = mat.HasProperty(PropBaseColor) ? mat.GetColor(PropBaseColor) : Color.white;
                c.a = alpha;
                if (mat.HasProperty(PropBaseColor)) mat.SetColor(PropBaseColor, c);
                if (mat.HasProperty(PropColor)) mat.SetColor(PropColor, c);
                mat.SetFloat("_Surface", 1);
                mat.SetOverrideTag("RenderType", "Transparent");
                mat.renderQueue = 3000;
                mat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
                mat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
                mat.SetInt("_ZWrite", 0);
                mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
            }
        }
    }

    // ══════════════════════════════════════════════════════════════════
    //  4) TOAST — Success / Error Card
    // ══════════════════════════════════════════════════════════════════

    private void BuildToastPanel()
    {
        toastPanel = MakePanel(mainCanvas.transform, "ToastPanel",
            new Vector2(0.5f, 1), new Vector2(0.5f, 1), new Vector2(0.5f, 1),
            new Vector2(0, -DS.ToastTopY), new Vector2(DS.ToastW, DS.ToastH), DS.GlassStrong);
        AddShadow(toastPanel, DS.ShadowStrong, 10f);
        AddShadow(toastPanel, DS.Shadow, 3f);
        var cg = toastPanel.AddComponent<CanvasGroup>();
        cg.alpha = 0;
        cg.blocksRaycasts = false;
        toastPanel.SetActive(false);
    }

    private void ShowToast(string title, string subtitle = null, bool success = true)
    {
        if (!toastPanel) return;
        if (activeToastCo != null) StopCoroutine(activeToastCo);
        foreach (Transform child in toastPanel.transform) Destroy(child.gameObject);
        toastPanel.SetActive(true);
        var cg = toastPanel.GetComponent<CanvasGroup>();
        cg.alpha = 0;
        cg.blocksRaycasts = false;

        // Icon
        var iconBg = MakePanel(toastPanel.transform, "IconBg",
            new Vector2(0, 0.5f), new Vector2(0, 0.5f), new Vector2(0, 0.5f),
            new Vector2(DS.Pad, 0), new Vector2(36, 36), success ? DS.Accent : DS.Danger);
        if (success) DrawCheckIcon(iconBg.transform, 18f, Color.white);
        else DrawXIcon(iconBg.transform, 14f, Color.white);

        float textX = DS.Pad + 36 + DS.PadS;
        float titleY = string.IsNullOrEmpty(subtitle) ? 0 : 8;
        var titleTxt = MakeText(toastPanel.transform, "TTitle", title,
            17f, FontStyles.Bold, DS.TextPrimary, TextAlignmentOptions.TopLeft);
        SetRect(titleTxt.rectTransform, new Vector2(0, 0.5f), new Vector2(1, 0.5f), new Vector2(0, 0.5f),
            new Vector2(textX, titleY), new Vector2(-textX - DS.Pad, 24));

        if (!string.IsNullOrEmpty(subtitle))
        {
            var subTxt = MakeText(toastPanel.transform, "TSub", subtitle,
                14f, FontStyles.Normal, DS.TextSecondary, TextAlignmentOptions.TopLeft);
            SetRect(subTxt.rectTransform, new Vector2(0, 0.5f), new Vector2(1, 0.5f), new Vector2(0, 0.5f),
                new Vector2(textX, -10), new Vector2(-textX - DS.Pad, 20));
        }
        activeToastCo = StartCoroutine(ToastAnim(cg));
    }

    private IEnumerator ToastAnim(CanvasGroup cg)
    {
        yield return AnimFade(cg, 0, 1, DS.AnimFast);
        yield return new WaitForSecondsRealtime(DS.ToastHold);
        yield return AnimFade(cg, 1, 0, DS.AnimNormal);
        toastPanel.SetActive(false);
        activeToastCo = null;
    }

    // ══════════════════════════════════════════════════════════════════
    //  5) MEASUREMENT CARD
    // ══════════════════════════════════════════════════════════════════

    private void BuildMeasureCard()
    {
        measureCard = MakePanel(mainCanvas.transform, "MeasureCard",
            new Vector2(0, 1), new Vector2(0, 1), new Vector2(0, 1),
            new Vector2(DS.Pad, -DS.Pad), new Vector2(DS.MeasureW, DS.MeasureH), DS.GlassStrong);
        AddShadow(measureCard, DS.ShadowStrong, 8f);
        AddShadow(measureCard, DS.Shadow, 3f);

        measureTitle = MakeText(measureCard.transform, "MT", "",
            16f, FontStyles.Bold, DS.TextPrimary, TextAlignmentOptions.TopLeft);
        SetRect(measureTitle.rectTransform, new Vector2(0, 1), new Vector2(1, 1), new Vector2(0, 1),
            new Vector2(DS.Pad, -DS.PadS), new Vector2(-DS.Pad * 2, 22));

        var tag = MakeText(measureCard.transform, "MTag", "Real scale",
            11f, FontStyles.Italic, DS.TextSecondary, TextAlignmentOptions.TopRight);
        SetRect(tag.rectTransform, new Vector2(0, 1), new Vector2(1, 1), new Vector2(1, 1),
            new Vector2(-DS.Pad, -DS.PadS), new Vector2(-DS.Pad * 2, 16));

        var div = MakePanel(measureCard.transform, "Div",
            new Vector2(0, 1), new Vector2(1, 1), new Vector2(0.5f, 1),
            new Vector2(0, -36), new Vector2(-DS.Pad * 2, 1), new Color(0.9f, 0.9f, 0.9f, 1));
        div.GetComponent<Image>().raycastTarget = false;

        measureH = MakeText(measureCard.transform, "MH", "", 15f, FontStyles.Normal, DS.TextPrimary, TextAlignmentOptions.Left);
        SetRect(measureH.rectTransform, new Vector2(0, 1), new Vector2(1, 1), new Vector2(0, 1),
            new Vector2(DS.Pad, -44), new Vector2(-DS.Pad * 2, 22));
        measureW = MakeText(measureCard.transform, "MW", "", 15f, FontStyles.Normal, DS.TextPrimary, TextAlignmentOptions.Left);
        SetRect(measureW.rectTransform, new Vector2(0, 1), new Vector2(1, 1), new Vector2(0, 1),
            new Vector2(DS.Pad, -66), new Vector2(-DS.Pad * 2, 22));
        measureD = MakeText(measureCard.transform, "MD", "", 15f, FontStyles.Normal, DS.TextPrimary, TextAlignmentOptions.Left);
        SetRect(measureD.rectTransform, new Vector2(0, 1), new Vector2(1, 1), new Vector2(0, 1),
            new Vector2(DS.Pad, -88), new Vector2(-DS.Pad * 2, 22));

        measureCard.SetActive(false);
    }

    private void UpdateMeasureCard()
    {
        if (!measureCard) return;
        if (!selectedObject) { if (measureCard.activeSelf) measureCard.SetActive(false); return; }
        if (!measureCard.activeSelf) measureCard.SetActive(true);
        Bounds b = GetWorldBoundsFromRenderers(selectedObject);
        Vector3 s = b.size;
        var info = selectedObject.GetComponent<PlacedPotInfo>();
        string nm = "Plant";
        if (info != null && potNames != null && info.potIndex < potNames.Length) nm = potNames[info.potIndex];
        measureTitle.text = nm;
        measureH.text = string.Format("H  {0:F1} cm", s.y * 100f);
        measureW.text = string.Format("W  {0:F1} cm", s.x * 100f);
        measureD.text = string.Format("D  {0:F1} cm", s.z * 100f);
    }

