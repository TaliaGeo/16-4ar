    // ══════════════════════════════════════════════════════════════════
    //  LIFECYCLE
    // ══════════════════════════════════════════════════════════════════

    private void Awake()
    {
        if (!raycastManager) raycastManager = FindFirstObjectByType<ARRaycastManager>();
        if (!planeManager)   planeManager   = FindFirstObjectByType<ARPlaneManager>();
        if (!anchorManager)  anchorManager  = FindFirstObjectByType<ARAnchorManager>();
        if (!arCamera)       arCamera       = Camera.main;
        _tintMPB = new MaterialPropertyBlock();
        if (s_ClearMPB == null) s_ClearMPB = new MaterialPropertyBlock();
        AutoLoadPotThumbnails();
        BuildAllUI();
    }

    /// <summary>Auto-load pot images from Resources/potsphoto if potThumbnails is empty.</summary>
    private void AutoLoadPotThumbnails()
    {
        if (potThumbnails != null && potThumbnails.Length > 0) return;
        string[] names = new string[] { "pot2", "pot2 1" };
        var list = new List<Sprite>();
        foreach (var n in names)
        {
            var tex = Resources.Load<Texture2D>("potsphoto/" + n);
            if (tex != null)
                list.Add(Sprite.Create(tex, new Rect(0, 0, tex.width, tex.height), new Vector2(0.5f, 0.5f)));
        }
        if (list.Count > 0) potThumbnails = list.ToArray();
    }

    private void Start()
    {
        SelectPot(0);
        ShowOnboardCard();
    }

    private void Update()
    {
        HandleTouch();
        HandlePinchScaling();
        UpdatePreviewGhost();
        UpdateOnboardCard();
        UpdateMeasureCard();
    }

    // ══════════════════════════════════════════════════════════════════
    //  UI BUILDING — MASTER
    // ══════════════════════════════════════════════════════════════════

    private void BuildAllUI()
    {
        mainCanvas = FindOrCreateCanvas();
        BuildBottomBar();
        BuildConfirmBar();
        BuildToastPanel();
        BuildMeasureCard();
        BuildOnboardCard();
        BuildDeletePill();
        SetConfirmBarVisible(false);
    }

    private Canvas FindOrCreateCanvas()
    {
        // Disable ALL existing scene canvases (kills old baked-in menus)
        var old = FindObjectsByType<Canvas>(FindObjectsSortMode.None);
        foreach (var c in old)
            c.gameObject.SetActive(false);

        // Ensure an EventSystem exists (buttons won't work without one)
        if (EventSystem.current == null)
        {
            // Re-enable a disabled one if it exists
            var es = FindFirstObjectByType<EventSystem>(FindObjectsInactive.Include);
            if (es != null)
                es.gameObject.SetActive(true);
            else
            {
                var esGo = new GameObject("EventSystem");
                esGo.AddComponent<EventSystem>();
                esGo.AddComponent<StandaloneInputModule>();
            }
        }

        // Always create a fresh canvas
        var go = new GameObject("ARCanvas");
        var canvas = go.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 100;
        var scaler = go.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1080, 2340);
        scaler.matchWidthOrHeight = 0.5f;
        go.AddComponent<GraphicRaycaster>();
        return canvas;
    }

    // ══════════════════════════════════════════════════════════════════
    //  1) BOTTOM ACTION BAR
    // ══════════════════════════════════════════════════════════════════

    private void BuildBottomBar()
    {
        float totalW = DS.BarIconSide + DS.BarGap + DS.BarIconCenter + DS.BarGap + DS.BarIconSide + DS.Pad * 2 + DS.PadL;
        bottomBar = MakePanel(mainCanvas.transform, "BottomBar",
            new Vector2(0.5f, 0), new Vector2(0.5f, 0), new Vector2(0.5f, 0),
            new Vector2(0, DS.BarBottomY), new Vector2(totalW, DS.BarH), DS.GlassStrong);
        AddLayeredShadow(bottomBar);
        var hlBar = MakePanel(bottomBar.transform, "BarHL",
            new Vector2(0, 1), new Vector2(1, 1), new Vector2(0.5f, 1),
            Vector2.zero, new Vector2(0, 2f), DS.Highlight);
        hlBar.GetComponent<Image>().raycastTarget = false;
        var cg = bottomBar.AddComponent<CanvasGroup>();
        cg.blocksRaycasts = true;

        float leftX = -(DS.BarIconCenter * 0.5f + DS.BarGap + DS.BarIconSide * 0.5f);
        var delBtn = MakeIconButton(bottomBar.transform, "BarDelete",
            DS.BarIconSide, DS.Surface, DS.IconDefault, "trash", leftX, 0);
        AddShadow(delBtn.gameObject, DS.Shadow, 4f);
        delBtn.onClick.AddListener(() => { if (deleteMode) ExitDeleteMode(); else EnterDeleteMode(); });

        var addBtn = MakeIconButton(bottomBar.transform, "BarAdd",
            DS.BarIconCenter, DS.Accent, Color.white, "plus", 0, 0);
        AddShadow(addBtn.gameObject, DS.ShadowStrong, 6f);
        addBtn.onClick.AddListener(() => { if (menuOpen) CloseMenuSheet(); else OpenMenuSheet(); });

        float rightX = DS.BarIconCenter * 0.5f + DS.BarGap + DS.BarIconSide * 0.5f;
        var shotBtn = MakeIconButton(bottomBar.transform, "BarShot",
            DS.BarIconSide, DS.Surface, DS.IconDefault, "camera", rightX, 0);
        AddShadow(shotBtn.gameObject, DS.Shadow, 4f);
        shotBtn.onClick.AddListener(() => TakeScreenshot());
    }

    // ══════════════════════════════════════════════════════════════════
    //  2) PLANT MENU / BOTTOM SHEET
    // ══════════════════════════════════════════════════════════════════

    private void OpenMenuSheet()
    {
        if (menuOpen) return;
        menuOpen = true;

        // Overlay
        menuOverlay = MakePanel(mainCanvas.transform, "MenuOverlay",
            Vector2.zero, Vector2.one, new Vector2(0.5f, 0.5f),
            Vector2.zero, Vector2.zero, DS.Overlay);
        var overlayImg = menuOverlay.GetComponent<Image>();
        overlayImg.raycastTarget = true;
        var overlayBtn = menuOverlay.AddComponent<Button>();
        overlayBtn.transition = Selectable.Transition.None;
        overlayBtn.targetGraphic = overlayImg;
        overlayBtn.onClick.AddListener(CloseMenuSheet);

        // Sheet — light grey background, bigger layout
        int count = potPrefabs != null ? potPrefabs.Length : 0;
        float sheetH = 120 + DS.CardH + DS.Pad * 2 + DS.PadL;
        Color sheetGrey = new Color(0.92f, 0.92f, 0.92f, 0.97f);
        menuSheet = MakePanel(mainCanvas.transform, "MenuSheet",
            new Vector2(0, 0), new Vector2(1, 0), new Vector2(0.5f, 0),
            Vector2.zero, new Vector2(0, sheetH), sheetGrey);
        AddLayeredShadow(menuSheet);
        var sheetHL = MakePanel(menuSheet.transform, "SheetHL",
            new Vector2(0, 1), new Vector2(1, 1), new Vector2(0.5f, 1),
            Vector2.zero, new Vector2(0, 1.5f), DS.Highlight);
        sheetHL.GetComponent<Image>().raycastTarget = false;

        // Title — much bigger
        var title = MakeText(menuSheet.transform, "SheetTitle", "Menu",
            DS.SheetTitleSize, FontStyles.Bold, DS.TextPrimary, TextAlignmentOptions.Left);
        SetRect(title.rectTransform, new Vector2(0, 1), new Vector2(1, 1), new Vector2(0, 1),
            new Vector2(DS.PadL, -DS.Pad), new Vector2(-DS.PadL * 2, 48));

        // Done button (top-right) — bigger
        var doneGo = new GameObject("DoneBtn");
        doneGo.transform.SetParent(menuSheet.transform, false);
        var doneRect = doneGo.AddComponent<RectTransform>();
        doneRect.anchorMin = new Vector2(1, 1);
        doneRect.anchorMax = new Vector2(1, 1);
        doneRect.pivot = new Vector2(1, 1);
        doneRect.anchoredPosition = new Vector2(-DS.Pad, -DS.Pad + 4);
        doneRect.sizeDelta = new Vector2(DS.DoneBtnW, DS.DoneBtnH);
        var doneImg = doneGo.AddComponent<Image>();
        doneImg.color = DS.AccentSoft;
        doneImg.raycastTarget = true;
        var doneBtn = doneGo.AddComponent<Button>();
        doneBtn.targetGraphic = doneImg;
        doneBtn.onClick.AddListener(CloseMenuSheet);
        AddShadow(doneGo, DS.Shadow, 3f);
        var doneTxt = MakeText(doneGo.transform, "DoneTxt", "Done",
            DS.DoneFontSize, FontStyles.Bold, DS.Accent, TextAlignmentOptions.Center);
        doneTxt.rectTransform.anchorMin = Vector2.zero;
        doneTxt.rectTransform.anchorMax = Vector2.one;
        doneTxt.rectTransform.offsetMin = Vector2.zero;
        doneTxt.rectTransform.offsetMax = Vector2.zero;

        // Plant cards
        float startX = DS.PadL;
        plantCardImages.Clear();
        for (int i = 0; i < count; i++)
        {
            int idx = i;
            float x = startX + i * (DS.CardW + DS.CardGap);
            var card = MakePanel(menuSheet.transform, "PlantCard" + i,
                new Vector2(0, 0), new Vector2(0, 0), new Vector2(0, 0),
                new Vector2(x, DS.Pad), new Vector2(DS.CardW, DS.CardH), DS.CardBg);
            AddShadow(card, DS.ShadowStrong, 8f);
            AddShadow(card, DS.Shadow, 3f);
            var cardImg = card.GetComponent<Image>();
            cardImg.raycastTarget = true;
            plantCardImages.Add(cardImg);

            // Image area (top ~72%) — preserves aspect ratio with padding
            var imgArea = MakePanel(card.transform, "ImgArea",
                new Vector2(0.06f, 0.30f), new Vector2(0.94f, 0.94f), new Vector2(0.5f, 0.5f),
                Vector2.zero, Vector2.zero, DS.Transparent);
            imgArea.GetComponent<Image>().raycastTarget = false;
            bool hasThumb = potThumbnails != null && i < potThumbnails.Length && potThumbnails[i] != null;
            if (hasThumb)
            {
                var thumbGo = new GameObject("Thumb");
                thumbGo.transform.SetParent(imgArea.transform, false);
                var thumbRT = thumbGo.AddComponent<RectTransform>();
                thumbRT.anchorMin = Vector2.zero; thumbRT.anchorMax = Vector2.one;
                thumbRT.offsetMin = Vector2.zero; thumbRT.offsetMax = Vector2.zero;
                var thumbImg = thumbGo.AddComponent<Image>();
                thumbImg.sprite = potThumbnails[i];
                thumbImg.preserveAspect = true;
                thumbImg.raycastTarget = false;
            }
            else
            {
                var ph = MakePanel(imgArea.transform, "Placeholder",
                    new Vector2(0.1f, 0.1f), new Vector2(0.9f, 0.9f), new Vector2(0.5f, 0.5f),
                    Vector2.zero, Vector2.zero, DS.Surface);
                ph.GetComponent<Image>().raycastTarget = false;
            }

            // Name label (bottom ~25%)
            string nm = (potNames != null && i < potNames.Length) ? potNames[i] : "Plant " + (i + 1);
            var label = MakeText(card.transform, "Label", nm,
                18f, FontStyles.Bold, DS.TextPrimary, TextAlignmentOptions.Center);
            SetRect(label.rectTransform, Vector2.zero, new Vector2(1, 0.25f), new Vector2(0.5f, 0.5f),
                Vector2.zero, Vector2.zero);

            var cardBtn = card.AddComponent<Button>();
            cardBtn.targetGraphic = cardImg;
            cardBtn.onClick.AddListener(() => { SelectPot(idx); HighlightPlantCards(); });
        }
        HighlightPlantCards();
        StartCoroutine(AnimSlideY(menuSheet.GetComponent<RectTransform>(), -sheetH, 0, DS.AnimNormal));
    }

    private void CloseMenuSheet()
    {
        menuOpen = false;
        if (menuOverlay) Destroy(menuOverlay);
        if (menuSheet) Destroy(menuSheet);
        plantCardImages.Clear();
    }

    private void HighlightPlantCards()
    {
        for (int i = 0; i < plantCardImages.Count; i++)
        {
            if (!plantCardImages[i]) continue;
            bool sel = (i == selectedPotIndex);
            plantCardImages[i].color = sel ? DS.CardBgSel : DS.CardBg;
            var outline = plantCardImages[i].GetComponent<Outline>();
            if (sel)
            {
                if (!outline) outline = plantCardImages[i].gameObject.AddComponent<Outline>();
                outline.effectColor = DS.Accent;
                outline.effectDistance = new Vector2(3, -3);
                outline.enabled = true;
            }
            else if (outline) outline.enabled = false;
        }
    }

    // ══════════════════════════════════════════════════════════════════
