    private void BuildOnboardCard()
    {
        onboardCard = MakePanel(mainCanvas.transform, "OnboardCard",
            new Vector2(0.5f, 0.36f), new Vector2(0.5f, 0.36f), new Vector2(0.5f, 0.5f),
            Vector2.zero, new Vector2(DS.OnboardW, DS.OnboardH), DS.GlassStrong);
        AddShadow(onboardCard, DS.ShadowStrong, 8f);
        AddShadow(onboardCard, DS.Shadow, 3f);
        var txt = MakeText(onboardCard.transform, "Txt", "Move slowly to scan your space",
            16f, FontStyles.Normal, DS.TextPrimary, TextAlignmentOptions.Center);
        txt.rectTransform.anchorMin = Vector2.zero;
        txt.rectTransform.anchorMax = Vector2.one;
        txt.rectTransform.offsetMin = new Vector2(DS.Pad, 0);
        txt.rectTransform.offsetMax = new Vector2(-DS.Pad, 0);
        onboardCard.SetActive(false);
    }

    private void ShowOnboardCard() { if (onboardCard) onboardCard.SetActive(true); }

    private void UpdateOnboardCard()
    {
        if (!onboardCard || !onboardCard.activeSelf || planeManager == null) return;
        foreach (var p in planeManager.trackables)
        {
            if (p.alignment == PlaneAlignment.HorizontalUp)
            { StartCoroutine(FadeOutAndDisable(onboardCard)); return; }
        }
    }

    // ══════════════════════════════════════════════════════════════════
    //  7) DELETE MODE
    // ══════════════════════════════════════════════════════════════════

    private void BuildDeletePill()
    {
        deletePill = MakePanel(mainCanvas.transform, "DeletePill",
            new Vector2(0.5f, 1), new Vector2(0.5f, 1), new Vector2(0.5f, 1),
            new Vector2(0, -DS.PadL), new Vector2(250, DS.PillH), DS.DangerSoft);
        AddShadow(deletePill, DS.ShadowStrong, 6f);
        AddShadow(deletePill, DS.Shadow, 2f);
        var txt = MakeText(deletePill.transform, "Txt", "Tap a plant to remove",
            15f, FontStyles.Bold, DS.Danger, TextAlignmentOptions.Center);
        txt.rectTransform.anchorMin = Vector2.zero;
        txt.rectTransform.anchorMax = Vector2.one;
        txt.rectTransform.offsetMin = Vector2.zero;
        txt.rectTransform.offsetMax = Vector2.zero;
        deletePill.SetActive(false);
    }

    private void EnterDeleteMode()
    {
        deleteMode = true;
        if (deletePill) deletePill.SetActive(true);
    }

    private void ExitDeleteMode()
    {
        deleteMode = false;
        foreach (var obj in spawnedObjects)
            if (obj) SetObjectDeleteTint(obj, false);
        if (deletePill) deletePill.SetActive(false);
    }

    private void SetObjectDeleteTint(GameObject obj, bool tinted)
    {
        foreach (var r in obj.GetComponentsInChildren<Renderer>())
        {
            if (ShouldIgnoreRenderer(r)) continue;
            if (tinted)
            {
                _tintMPB.Clear();
                if (r.sharedMaterial.HasProperty(PropBaseColor))
                    _tintMPB.SetColor(PropBaseColor, Color.Lerp(r.sharedMaterial.GetColor(PropBaseColor), Color.red, 0.30f));
                if (r.sharedMaterial.HasProperty(PropColor))
                    _tintMPB.SetColor(PropColor, Color.Lerp(r.sharedMaterial.GetColor(PropColor), Color.red, 0.30f));
                r.SetPropertyBlock(_tintMPB);
            }
            else r.SetPropertyBlock(s_ClearMPB);
        }
    }

    private void DeleteObject(GameObject obj)
    {
        if (!obj) return;
        if (selectedObject == obj) selectedObject = null;
        spawnedObjects.Remove(obj);
        SetObjectDeleteTint(obj, false);
        var info = obj.GetComponent<PlacedPotInfo>();
        if (info && info.anchorObject) Destroy(info.anchorObject);
        else Destroy(obj);
        ShowToast("Removed");
    }

    // ══════════════════════════════════════════════════════════════════
    //  POT SELECTION
    // ══════════════════════════════════════════════════════════════════

    public void SelectPot(int index)
    {
        if (potPrefabs == null || potPrefabs.Length == 0) return;
        selectedPotIndex = Mathf.Clamp(index, 0, potPrefabs.Length - 1);
    }

    // ══════════════════════════════════════════════════════════════════
    //  TOUCH INPUT
    // ══════════════════════════════════════════════════════════════════

    private void HandleTouch()
    {
        if (menuOpen || isPreviewMode || Input.touchCount != 1) return;
        Touch touch = Input.GetTouch(0);
        if (touch.phase != TouchPhase.Began) return;
        if (IsPointerOverUI(touch)) return;
        if (Time.unscaledTime - lastTapTime < TAP_COOLDOWN) return;
        lastTapTime = Time.unscaledTime;

        Ray ray = arCamera.ScreenPointToRay(touch.position);
        if (Physics.Raycast(ray, out RaycastHit physHit, 100f))
        {
            GameObject tapped = FindSpawnedRootFromHit(physHit.collider.transform);
            if (tapped != null)
            {
                if (deleteMode) { DeleteObject(tapped); ExitDeleteMode(); }
                else if (enableTapSelection) selectedObject = tapped;
                return;
            }
        }
        if (deleteMode) { ExitDeleteMode(); return; }
        EnterPreviewMode();
    }

    private bool IsPointerOverUI(Touch touch)
    {
        if (EventSystem.current == null) return false;
        if (EventSystem.current.IsPointerOverGameObject(touch.fingerId)) return true;
        var ped = new PointerEventData(EventSystem.current) { position = touch.position };
        _uiRayResults.Clear();
        EventSystem.current.RaycastAll(ped, _uiRayResults);
        for (int i = 0; i < _uiRayResults.Count; i++)
        {
            var go = _uiRayResults[i].gameObject;
            if (go.layer == 5) return true;
            if (go.GetComponentInParent<Button>()) return true;
        }
        return false;
    }

    private GameObject FindSpawnedRootFromHit(Transform hit)
    {
        Transform t = hit;
        while (t != null) { if (spawnedObjects.Contains(t.gameObject)) return t.gameObject; t = t.parent; }
        return null;
    }

    // ══════════════════════════════════════════════════════════════════
    //  PLACEMENT
    // ══════════════════════════════════════════════════════════════════

    private void PlaceObjectAtPose(Pose hitPose, ARPlane hitPlane)
    {
        if (potPrefabs == null || potPrefabs.Length == 0) return;
        GameObject prefab = potPrefabs[selectedPotIndex];
        if (!prefab) return;

        if (hitPlane == null || hitPlane.trackingState != TrackingState.Tracking)
        { ShowToast("Surface lost", null, false); return; }

        if (!TryCreatePlacementAnchor(hitPose, hitPlane, out ARAnchor anchor))
        { ShowToast("Failed to anchor", null, false); return; }

        GameObject obj = Instantiate(prefab, anchor.transform);
        obj.transform.localPosition = Vector3.zero;
        obj.transform.localRotation = Quaternion.identity;

        // Scale to real-world height
        Vector3 normScale = Vector3.one;
        float realH = GetRealHeightForIndex(selectedPotIndex);
        if (realH > 0.01f) normScale = NormalizeObjectToHeightCm(obj, realH);
        obj.transform.localScale = normScale * defaultScale;

        // Face camera
        if (faceCameraOnPlace && arCamera)
        {
            Vector3 dir = arCamera.transform.position - hitPose.position; dir.y = 0f;
            if (dir.sqrMagnitude > 0.001f)
                obj.transform.rotation = Quaternion.LookRotation(-dir.normalized) * Quaternion.Euler(prefabRotationOffsetEuler);
        }

        if (autoFitColliderOnPlace) FitBoxColliderToRenderers(obj);

        // Ground using local position (child of anchor)
        GroundChildToAnchorSurface(obj);

        var info = obj.AddComponent<PlacedPotInfo>();
        info.potIndex = selectedPotIndex;
        info.surfaceY = hitPose.position.y + yOffset;
        info.normalizedBaseScale = normScale;
        info.anchorObject = anchor.gameObject;

        spawnedObjects.Add(obj);
        selectedObject = obj;
        string nm = (potNames != null && selectedPotIndex < potNames.Length) ? potNames[selectedPotIndex] : "Plant";
        ShowToast(nm + " placed");
    }

    // ══════════════════════════════════════════════════════════════════
    //  AR HELPERS
    // ══════════════════════════════════════════════════════════════════

    private bool TryCreatePlacementAnchor(Pose pose, ARPlane plane, out ARAnchor anchor)
    {
        anchor = null;
        if (anchorManager == null || plane == null) return false;
        anchor = anchorManager.AttachAnchor(plane, pose);
        return anchor != null;
    }

    private bool ValidatePlacementCandidate(ARRaycastHit hit, out ARPlane plane)
    {
        plane = null;
        if (planeManager == null) return false;
        plane = planeManager.GetPlane(hit.trackableId);
        if (plane == null) return false;
        if (plane.alignment != PlaneAlignment.HorizontalUp) return false;
        // Strict: require full Tracking for final placement
        if (plane.trackingState != TrackingState.Tracking) return false;
        var c = plane.classification;
        if (c == PlaneClassification.Wall || c == PlaneClassification.Ceiling ||
            c == PlaneClassification.Door || c == PlaneClassification.Window) return false;
        // Use actual polygon area
        if (ComputePolygonArea(plane) < 0.04f) return false;
        if (!IsPointInsidePlaneWithMargin(plane, hit.pose.position, 0.03f)) return false;
        return true;
    }

    /// <summary>Compute the actual polygon area of an ARPlane boundary using the shoelace formula.</summary>
    private float ComputePolygonArea(ARPlane plane)
    {
        if (plane == null || plane.boundary == null || plane.boundary.Length < 3) return 0f;
        var bnd = plane.boundary;
        float area = 0f;
        int n = bnd.Length;
        for (int i = 0; i < n; i++)
        {
            Vector2 a = bnd[i], b = bnd[(i + 1) % n];
            area += a.x * b.y - b.x * a.y;
        }
        return Mathf.Abs(area) * 0.5f;
    }

    /// <summary>Simple point-in-polygon without margin (used by preview and footprint probes).</summary>
    private bool IsPointInsidePlane(ARPlane plane, Vector3 worldPoint)
    {
        if (plane == null || plane.boundary == null || plane.boundary.Length < 3) return false;
        Vector3 local3 = plane.transform.InverseTransformPoint(worldPoint);
        Vector2 pt = new Vector2(local3.x, local3.z);
        var bnd = plane.boundary;
        int n = bnd.Length;
        bool inside = false;
        for (int i = 0, j = n - 1; i < n; j = i++)
        {
            Vector2 a = bnd[i], b = bnd[j];
            if (((a.y <= pt.y && pt.y < b.y) || (b.y <= pt.y && pt.y < a.y)) &&
                pt.x < (b.x - a.x) * (pt.y - a.y) / (b.y - a.y) + a.x)
                inside = !inside;
        }
        return inside;
    }

    /// <summary>Check that N probe points around the pot footprint are all inside the plane.</summary>
    private bool IsFootprintSupported(ARPlane plane, Vector3 center, float radius)
    {
        if (plane == null) return false;
        float probeR = Mathf.Max(radius - FOOTPRINT_MARGIN, 0.01f);
        for (int i = 0; i < FOOTPRINT_PROBES; i++)
        {
            float angle = (2f * Mathf.PI * i) / FOOTPRINT_PROBES;
            Vector3 probe = center + new Vector3(Mathf.Cos(angle) * probeR, 0f, Mathf.Sin(angle) * probeR);
            if (!IsPointInsidePlane(plane, probe)) return false;
        }
        return true;
    }

    private bool IsPointInsidePlaneWithMargin(ARPlane plane, Vector3 worldPoint, float margin)
    {
        if (plane == null || plane.boundary == null || plane.boundary.Length < 3) return false;
        Vector3 local3 = plane.transform.InverseTransformPoint(worldPoint);
        Vector2 pt = new Vector2(local3.x, local3.z);
        var bnd = plane.boundary;
        int n = bnd.Length;

        // 1) Point-in-polygon (ray casting / winding)
        bool inside = false;
        for (int i = 0, j = n - 1; i < n; j = i++)
        {
            Vector2 a = bnd[i], b = bnd[j];
            if (((a.y <= pt.y && pt.y < b.y) || (b.y <= pt.y && pt.y < a.y)) &&
                pt.x < (b.x - a.x) * (pt.y - a.y) / (b.y - a.y) + a.x)
                inside = !inside;
        }
        if (!inside) return false;

        // 2) Minimum distance from any edge
        float minD = float.MaxValue;
        for (int i = 0; i < n; i++)
        {
            Vector2 a = bnd[i], b = bnd[(i + 1) % n];
            Vector2 ab = b - a, ap = pt - a;
            float t = Mathf.Clamp01(Vector2.Dot(ap, ab) / Mathf.Max(ab.sqrMagnitude, 1e-8f));
            float d = Vector2.Distance(a + t * ab, pt);
            if (d < minD) minD = d;
        }
        return minD >= margin;
    }

    /// <summary>
    /// Ground a placed object (child of anchor) using localPosition only.
    /// Anchor stays untouched — only the child slides along local Y.
    /// </summary>
    private void GroundChildToAnchorSurface(GameObject obj)
    {
        Physics.SyncTransforms();
        Bounds b = GetWorldBoundsFromRenderers(obj);
        if (b.size == Vector3.zero) return;
        // The anchor sits at the surface. The child's world-space bottom
        // should match the anchor's world Y + yOffset.
        Transform anchor = obj.transform.parent;
        float anchorY = anchor != null ? anchor.position.y : obj.transform.position.y;
        float surfaceY = anchorY + yOffset;
        float bottomOffset = b.min.y - obj.transform.position.y;
        // Adjust local Y so bottom == surfaceY
        Vector3 lp = obj.transform.localPosition;
        lp.y = (surfaceY - anchor.position.y) - bottomOffset;
        obj.transform.localPosition = lp;
    }

    private void AlignObjectBottomToSurface(GameObject obj, float surfaceY)
    {
        Physics.SyncTransforms();
        Bounds b = GetWorldBoundsFromRenderers(obj);
        if (b.size == Vector3.zero) return;
        obj.transform.position += new Vector3(0f, surfaceY - b.min.y, 0f);
    }

    // ══════════════════════════════════════════════════════════════════
    //  PINCH SCALE
    // ══════════════════════════════════════════════════════════════════

    private void HandlePinchScaling()
    {
        if (Input.touchCount != 2 || !selectedObject || deleteMode) return;
        Touch t0 = Input.GetTouch(0), t1 = Input.GetTouch(1);
        float dist = Vector2.Distance(t0.position, t1.position);
        if (t0.phase == TouchPhase.Began || t1.phase == TouchPhase.Began)
        { startPinchDistance = dist; startScale = selectedObject.transform.localScale; return; }
        if (Mathf.Approximately(startPinchDistance, 0f)) return;
        float ratio = dist / startPinchDistance;
        var info = selectedObject.GetComponent<PlacedPotInfo>();
        Vector3 baseScale = info != null ? info.normalizedBaseScale : Vector3.one;
        float currentFactor = startScale.x / Mathf.Max(baseScale.x, 0.0001f);
        float targetFactor = Mathf.Clamp(currentFactor * ratio, minScale, maxScale);
        selectedObject.transform.localScale = baseScale * targetFactor;
        // Re-ground using local position only (anchor stays fixed)
        if (info != null && selectedObject.transform.parent != null)
            GroundChildToAnchorSurface(selectedObject);
    }

    // ══════════════════════════════════════════════════════════════════
    //  RENDERER / BOUNDS / COLLIDER / NORMALIZATION
    // ══════════════════════════════════════════════════════════════════

    private bool ShouldIgnoreRenderer(Renderer r)
    {
        if (!r) return true;
        if (ignoreRendererNameContains == null) return false;
        string n = r.gameObject.name.ToLowerInvariant();
        foreach (var s in ignoreRendererNameContains)
            if (!string.IsNullOrEmpty(s) && n.Contains(s.ToLowerInvariant())) return true;
        return false;
    }

    private Bounds GetWorldBoundsFromRenderers(GameObject root)
    {
        var rends = root.GetComponentsInChildren<Renderer>(true);
        Renderer first = null;
        foreach (var r in rends) if (!ShouldIgnoreRenderer(r)) { first = r; break; }
        if (!first) return new Bounds(root.transform.position, Vector3.zero);
        Bounds b = first.bounds;
        foreach (var r in rends) { if (!ShouldIgnoreRenderer(r)) b.Encapsulate(r.bounds); }
        return b;
    }

    private void FitBoxColliderToRenderers(GameObject root)
    {
        Bounds w = GetWorldBoundsFromRenderers(root);
        if (w.size == Vector3.zero) return;
        BoxCollider bc = root.GetComponent<BoxCollider>() ?? root.AddComponent<BoxCollider>();
        bc.center = root.transform.InverseTransformPoint(w.center);
        Vector3 ls = root.transform.lossyScale;
        bc.size = new Vector3(
            ls.x != 0 ? w.size.x / ls.x : w.size.x,
            ls.y != 0 ? w.size.y / ls.y : w.size.y,
            ls.z != 0 ? w.size.z / ls.z : w.size.z);
    }

    private Vector3 NormalizeObjectToHeightCm(GameObject root, float targetCm)
    {
        Bounds b = GetWorldBoundsFromRenderers(root);
        float f = (targetCm / 100f) / Mathf.Max(0.0001f, b.size.y);
        root.transform.localScale = Vector3.one * f;
        return root.transform.localScale;
    }

    private float GetRealHeightForIndex(int i)
    {
        if (potRealHeightCm == null || i < 0 || i >= potRealHeightCm.Length) return 0f;
        return potRealHeightCm[i];
    }

    // ══════════════════════════════════════════════════════════════════
    //  SCREENSHOT
    // ══════════════════════════════════════════════════════════════════

    public void TakeScreenshot() => StartCoroutine(CaptureCoroutine());

    private IEnumerator CaptureCoroutine()
    {
        bool barW = bottomBar && bottomBar.activeSelf;
        bool measW = measureCard && measureCard.activeSelf;
        bool pillW = deletePill && deletePill.activeSelf;
        bool toastW = toastPanel && toastPanel.activeSelf;
        bool onbW = onboardCard && onboardCard.activeSelf;
        bool confW = confirmBar && confirmBar.activeSelf;

        if (bottomBar) bottomBar.SetActive(false);
        if (measureCard) measureCard.SetActive(false);
        if (deletePill) deletePill.SetActive(false);
        if (toastPanel) toastPanel.SetActive(false);
        if (onboardCard) onboardCard.SetActive(false);
        if (confirmBar) confirmBar.SetActive(false);

        yield return new WaitForEndOfFrame();
        Texture2D tex = ScreenCapture.CaptureScreenshotAsTexture();
        if (tex == null) { Restore(barW, measW, pillW, toastW, onbW, confW); ShowToast("Failed", null, false); yield break; }
        byte[] png = tex.EncodeToPNG(); Destroy(tex);
        string msg;
#if UNITY_ANDROID && !UNITY_EDITOR
        string fn = "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".png";
        string folder = "/storage/emulated/0/DCIM/MyDesigns/";
        try { Directory.CreateDirectory(folder); string p = Path.Combine(folder, fn); File.WriteAllBytes(p, png);
            using (var ms = new AndroidJavaClass("android.media.MediaScannerConnection"))
            using (var up = new AndroidJavaClass("com.unity3d.player.UnityPlayer"))
            using (var ctx = up.GetStatic<AndroidJavaObject>("currentActivity"))
                ms.CallStatic("scanFile", ctx, new string[]{p}, null, null);
            msg = "Saved to gallery"; onScreenshotSaved?.Invoke(p); }
        catch (Exception e) { Debug.LogError("Screenshot: " + e.Message); msg = "Save failed"; }
#else
        string dir = Path.Combine(Application.persistentDataPath, screenshotFolderName);
        Directory.CreateDirectory(dir);
        string fp = Path.Combine(dir, "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".png");
        File.WriteAllBytes(fp, png); msg = "Screenshot saved"; onScreenshotSaved?.Invoke(fp);
#endif
        Restore(barW, measW, pillW, toastW, onbW, confW);
        ShowToast(msg, "Snapshot saved successfully");
    }

    private void Restore(bool bar, bool meas, bool pill, bool toast, bool onb, bool conf)
    {
        if (bottomBar) bottomBar.SetActive(bar);
        if (measureCard) measureCard.SetActive(meas);
        if (deletePill) deletePill.SetActive(pill);
        if (toastPanel) toastPanel.SetActive(toast);
        if (onboardCard) onboardCard.SetActive(onb);
        if (confirmBar) confirmBar.SetActive(conf);
    }

    // ══════════════════════════════════════════════════════════════════
    //  UI FACTORY HELPERS
    // ══════════════════════════════════════════════════════════════════

    private GameObject MakePanel(Transform parent, string name,
        Vector2 aMin, Vector2 aMax, Vector2 pivot, Vector2 pos, Vector2 size, Color color)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var r = go.AddComponent<RectTransform>();
        r.anchorMin = aMin; r.anchorMax = aMax; r.pivot = pivot;
        r.anchoredPosition = pos; r.sizeDelta = size;
        var img = go.AddComponent<Image>();
        img.color = color; img.raycastTarget = false;
        return go;
    }

    private TMP_Text MakeText(Transform parent, string name, string text,
        float sz, FontStyles style, Color color, TextAlignmentOptions align)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        go.AddComponent<RectTransform>();
        var tmp = go.AddComponent<TextMeshProUGUI>();
        tmp.text = text; tmp.fontSize = sz; tmp.fontStyle = style;
        tmp.color = color; tmp.alignment = align;
        tmp.enableWordWrapping = true; tmp.raycastTarget = false;
        return tmp;
    }

    private void SetRect(RectTransform rt, Vector2 aMin, Vector2 aMax, Vector2 pivot, Vector2 pos, Vector2 size)
    {
        rt.anchorMin = aMin; rt.anchorMax = aMax; rt.pivot = pivot;
        rt.anchoredPosition = pos; rt.sizeDelta = size;
    }

    private Button MakeIconButton(Transform parent, string name,
        float size, Color bg, Color iconColor, string icon, float x, float y)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var rect = go.AddComponent<RectTransform>();
        rect.anchorMin = rect.anchorMax = rect.pivot = new Vector2(0.5f, 0.5f);
        rect.anchoredPosition = new Vector2(x, y);
        rect.sizeDelta = new Vector2(size, size);
        var img = go.AddComponent<Image>();
        img.color = bg; img.raycastTarget = true;
        var btn = go.AddComponent<Button>();
        btn.targetGraphic = img;
        var c = btn.colors;
        c.pressedColor = new Color(0.85f, 0.85f, 0.85f, 1f);
        btn.colors = c;
        float ic = size * 0.45f;
        switch (icon)
        {
            case "trash":  DrawTrashIcon(go.transform, ic, iconColor); break;
            case "plus":   DrawPlusIcon(go.transform, ic, iconColor); break;
            case "camera": DrawCameraIcon(go.transform, ic, iconColor); break;
            case "check":  DrawCheckIcon(go.transform, ic, iconColor); break;
            case "x":      DrawXIcon(go.transform, ic, iconColor); break;
        }
        return btn;
    }

    private static void AddShadow(GameObject go, Color color, float offset)
    {
        var s = go.AddComponent<Shadow>();
        s.effectColor = color; s.effectDistance = new Vector2(0, -offset);
    }

    private static void AddLayeredShadow(GameObject go)
    {
        var s1 = go.AddComponent<Shadow>();
        s1.effectColor = DS.Shadow; s1.effectDistance = new Vector2(0, -3f);
        var s2 = go.AddComponent<Shadow>();
        s2.effectColor = DS.ShadowStrong; s2.effectDistance = new Vector2(0, -10f);
        var s3 = go.AddComponent<Shadow>();
        s3.effectColor = DS.ShadowDeep; s3.effectDistance = new Vector2(0, -20f);
    }

    // ── Procedural icons ──
    private void DrawPlusIcon(Transform p, float s, Color c)
    { float t = s * 0.2f; MakeRect(p, "PH", new Vector2(s, t), Vector2.zero, c); MakeRect(p, "PV", new Vector2(t, s), Vector2.zero, c); }

    private void DrawXIcon(Transform p, float s, Color c)
    {
        float t = s * 0.18f;
        var a = MakeRect(p, "X1", new Vector2(s * 1.1f, t), Vector2.zero, c);
        a.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, 45);
        var b = MakeRect(p, "X2", new Vector2(s * 1.1f, t), Vector2.zero, c);
        b.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, -45);
    }

    private void DrawCheckIcon(Transform p, float s, Color c)
    {
        float t = s * 0.2f;
        var sa = MakeRect(p, "C1", new Vector2(s * 0.4f, t), new Vector2(-s * 0.15f, -s * 0.05f), c);
        sa.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, -45);
        var la = MakeRect(p, "C2", new Vector2(s * 0.7f, t), new Vector2(s * 0.15f, s * 0.1f), c);
        la.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, 45);
    }

    private void DrawCameraIcon(Transform p, float s, Color c)
    {
        MakeRect(p, "Cam", new Vector2(s * 1.2f, s * 0.8f), new Vector2(0, -s * 0.05f), c);
        MakeRect(p, "Bump", new Vector2(s * 0.4f, s * 0.22f), new Vector2(0, s * 0.4f + s * 0.07f), c);
        MakeRect(p, "Lens", new Vector2(s * 0.3f, s * 0.3f), new Vector2(0, -s * 0.05f), new Color(0, 0, 0, 0.4f));
    }

    private void DrawTrashIcon(Transform p, float s, Color c)
    {
        MakeRect(p, "Lid", new Vector2(s * 1.1f, s * 0.14f), new Vector2(0, s * 0.4f), c);
        MakeRect(p, "Knob", new Vector2(s * 0.3f, s * 0.12f), new Vector2(0, s * 0.52f), c);
        MakeRect(p, "Body", new Vector2(s * 0.8f, s * 0.7f), new Vector2(0, -s * 0.05f), c);
    }

    private GameObject MakeRect(Transform parent, string name, Vector2 size, Vector2 offset, Color color)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var r = go.AddComponent<RectTransform>();
        r.sizeDelta = size; r.anchoredPosition = offset;
        var img = go.AddComponent<Image>();
        img.color = color; img.raycastTarget = false;
        return go;
    }

    // ── Animation helpers ──
    private IEnumerator AnimFade(CanvasGroup cg, float from, float to, float dur)
    {
        float t = 0; cg.alpha = from;
        while (t < dur) { cg.alpha = Mathf.Lerp(from, to, t / dur); t += Time.unscaledDeltaTime; yield return null; }
        cg.alpha = to;
    }

    private IEnumerator AnimSlideY(RectTransform rt, float fromY, float toY, float dur)
    {
        float t = 0; var pos = rt.anchoredPosition;
        while (t < dur) { pos.y = Mathf.Lerp(fromY, toY, t / dur); rt.anchoredPosition = pos; t += Time.unscaledDeltaTime; yield return null; }
        pos.y = toY; rt.anchoredPosition = pos;
    }

    private IEnumerator FadeOutAndDisable(GameObject go)
    {
        var cg = go.GetComponent<CanvasGroup>() ?? go.AddComponent<CanvasGroup>();
        yield return AnimFade(cg, 1, 0, DS.AnimSlow);
        go.SetActive(false); cg.alpha = 1;
    }
}
