    private void EnsureRuntimeUI()
    {
        mainCanvas = FindOrCreateCanvas();
        BuildOnboardingCard();
        BuildBottomBar();
        BuildMeasurementCard();
        BuildDeletePill();
        BuildToastPanel();
        // Menu sheet is built on demand
    }

    private void BuildOnboardingCard()
    {
        onboardingCard = new GameObject("OnboardingCard");
        onboardingCard.transform.SetParent(mainCanvas.transform, false);
        var rect = onboardingCard.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.5f, 0.5f);
        rect.anchorMax = new Vector2(0.5f, 0.5f);
        rect.pivot = new Vector2(0.5f, 0.5f);
        rect.anchoredPosition = new Vector2(0, 0);
        rect.sizeDelta = new Vector2(260, 60);
        var img = onboardingCard.AddComponent<Image>();
        SetCard(img);
        AddShadow(onboardingCard, DS.CardShadowSize, DS.CardShadowOffset);
        onboardingText = onboardingCard.AddComponent<TMP_Text>();
        onboardingText.text = "Scan your space";
        onboardingText.fontSize = 20f;
        onboardingText.alignment = TextAlignmentOptions.Center;
        onboardingText.color = DS.TextDark;
        onboardingText.fontStyle = FontStyles.Bold;
        onboardingText.rectTransform.anchorMin = Vector2.zero;
        onboardingText.rectTransform.anchorMax = Vector2.one;
        onboardingText.rectTransform.offsetMin = Vector2.zero;
        onboardingText.rectTransform.offsetMax = Vector2.zero;
        onboardingCard.SetActive(true);
    }

    private void BuildBottomBar()
    {
        bottomBar = new GameObject("BottomBar");
        bottomBar.transform.SetParent(mainCanvas.transform, false);
        var rect = bottomBar.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.5f, 0f);
        rect.anchorMax = new Vector2(0.5f, 0f);
        rect.pivot = new Vector2(0.5f, 0f);
        rect.anchoredPosition = new Vector2(0, 32);
        rect.sizeDelta = new Vector2(DS.PaddingLarge * 2 + DS.IconSizeXL * 3 + DS.Padding * 2, DS.BarHeight);
        var img = bottomBar.AddComponent<Image>();
        SetFrosted(img);
        AddShadow(bottomBar, DS.CardShadowSize, DS.CardShadowOffset);
        SetRounded(img, DS.BarRadius);
        // Delete button
        barDeleteBtn = CreateBarIconButton(bottomBar.transform, "BarDeleteBtn", DS.IconSize, DS.Danger, "delete");
        barDeleteBtn.GetComponent<RectTransform>().anchoredPosition = new Vector2(-DS.IconSizeXL - DS.Padding, 0);
        // Add button (center, larger)
        barAddBtn = CreateBarIconButton(bottomBar.transform, "BarAddBtn", DS.IconSizeXL, DS.Accent, "add");
        barAddBtn.GetComponent<RectTransform>().anchoredPosition = new Vector2(0, 0);
        // Screenshot button
        barShotBtn = CreateBarIconButton(bottomBar.transform, "BarShotBtn", DS.IconSize, DS.IconDark, "camera");
        barShotBtn.GetComponent<RectTransform>().anchoredPosition = new Vector2(DS.IconSizeXL + DS.Padding, 0);
        // Wire up
        barDeleteBtn.onClick.AddListener(() => EnterDeleteMode());
        barAddBtn.onClick.AddListener(() => OpenMenuSheet());
        barShotBtn.onClick.AddListener(() => ShowSaveNameDialog());
    }

    private Button CreateBarIconButton(Transform parent, string name, float size, Color color, string icon)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var rect = go.AddComponent<RectTransform>();
        rect.sizeDelta = new Vector2(size + DS.Padding, size + DS.Padding);
        var btn = go.AddComponent<Button>();
        var img = go.AddComponent<Image>();
        img.color = color;
        SetRounded(img, size / 2f);
        AddShadow(go, DS.CardShadowSize * 0.7f, DS.CardShadowOffset * 0.7f);
        // TODO: Replace with premium SVG icon or sprite
        // For now, use procedural icon
        switch (icon)
        {
            case "delete": CreateXIcon(go.transform, size * 0.7f, Color.white); break;
            case "add": CreatePlusIcon(go.transform, size * 0.7f, Color.white); break;
            case "camera": CreateCameraIcon(go.transform, size * 0.7f, Color.white); break;
        }
        return btn;
    }

