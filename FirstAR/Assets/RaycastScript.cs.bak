    // Utility: Add shadow to UI element
    private static void AddShadow(GameObject go, float size, float offsetY, Color? color = null)
    {
        var shadow = go.AddComponent<UnityEngine.UI.Shadow>();
        shadow.effectColor = color ?? DS.CardShadow;
        shadow.effectDistance = new Vector2(0, offsetY);
        // For more advanced shadow, use custom shaders or 9-slice images
    }

    // Utility: Set rounded corners (for Image)
    private static void SetRounded(Image img, float radius)
    {
        // If using Unity 2022+ with SpriteShape or MaskableGraphic, set type to Sliced and assign a 9-slice sprite
        // Otherwise, use a custom mask or asset for true rounded corners
        // For now, just document the intent
        img.type = Image.Type.Sliced;
        // img.sprite = ... assign a 9-slice sprite with correct border for radius
    }

    // Utility: Set frosted glass style
    private static void SetFrosted(Image img)
    {
        img.color = DS.FrostedGlass;
        // Optionally, assign a frosted glass sprite or material
    }

    // Utility: Set card style
    private static void SetCard(Image img, bool danger = false)
    {
        img.color = danger ? DS.CardDanger : DS.Card;
        // Optionally, assign a card sprite or material
    }
    // Utility: Set icon color
    private static void SetIconColor(Image img, bool enabled = true)
    {
        img.color = enabled ? DS.IconDark : DS.IconDisabled;
    }
    // Utility: Set text style
    private static void SetTextStyle(TMP_Text txt, bool subtle = false, bool bold = false)
    {
        txt.color = subtle ? DS.TextSubtle : DS.TextDark;
        txt.fontStyle = bold ? FontStyles.Bold : FontStyles.Normal;
    }
    // Utility: Animate fade in/out (coroutine)
    private IEnumerator FadeCanvasGroup(CanvasGroup cg, float from, float to, float duration)
    {
        float t = 0f;
        cg.alpha = from;
        while (t < duration)
        {
            cg.alpha = Mathf.Lerp(from, to, t / duration);
            t += Time.unscaledDeltaTime;
            yield return null;
        }
        cg.alpha = to;
    }
    // Utility: Animate slide (vertical)
    private IEnumerator SlideRect(RectTransform rt, float fromY, float toY, float duration)
    {
        float t = 0f;
        Vector2 start = rt.anchoredPosition;
        Vector2 end = new Vector2(start.x, toY);
        rt.anchoredPosition = new Vector2(start.x, fromY);
        while (t < duration)
        {
            rt.anchoredPosition = Vector2.Lerp(new Vector2(start.x, fromY), end, t / duration);
            t += Time.unscaledDeltaTime;
            yield return null;
        }
        rt.anchoredPosition = end;
    }
    // Utility: Animate pop (scale)
    private IEnumerator PopRect(RectTransform rt, float from, float to, float duration)
    {
        float t = 0f;
        while (t < duration)
        {
            float s = Mathf.Lerp(from, to, t / duration);
            rt.localScale = Vector3.one * s;
            t += Time.unscaledDeltaTime;
            yield return null;
        }
        rt.localScale = Vector3.one * to;
    }
    // Utility: Animate fade and destroy
    private IEnumerator FadeAndDestroy(CanvasGroup cg, float duration)
    {
        float t = 0f;
        float start = cg.alpha;
        while (t < duration)
        {
            cg.alpha = Mathf.Lerp(start, 0f, t / duration);
            t += Time.unscaledDeltaTime;
            yield return null;
        }
        cg.alpha = 0f;
        Destroy(cg.gameObject);
    }
    // Utility: Animate fade in and out, then destroy
    private IEnumerator FadeInOutAndDestroy(CanvasGroup cg, float inDur, float outDur, float hold)
    {
        yield return FadeCanvasGroup(cg, 0f, 1f, inDur);
        yield return new WaitForSecondsRealtime(hold);
        yield return FadeCanvasGroup(cg, 1f, 0f, outDur);
        Destroy(cg.gameObject);
        }

