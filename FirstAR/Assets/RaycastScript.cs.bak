    // ── Panel / text builder helpers ──

    private GameObject BuildPanel(Transform parent, string name,
                                  Vector2 anchorMin, Vector2 anchorMax,
                                  Vector2 pivot, Vector2 anchoredPos, Vector2 sizeDelta,
                                  Color bgColor)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);

        var rect = go.AddComponent<RectTransform>();
        rect.anchorMin = anchorMin;
        rect.anchorMax = anchorMax;
        rect.pivot = pivot;
        rect.anchoredPosition = anchoredPos;
        rect.sizeDelta = sizeDelta;

        var img = go.AddComponent<Image>();
        img.color = bgColor;
        img.raycastTarget = false;

        return go;
    }

    private TMP_Text AddTextToPanel(GameObject panel, string name, float fontSize,
                                    TextAlignmentOptions alignment, Color color,
                                    FontStyles style = FontStyles.Normal)
    {
        var go = new GameObject(name);
        go.transform.SetParent(panel.transform, false);

        var rect = go.AddComponent<RectTransform>();
        rect.anchorMin = Vector2.zero;
        rect.anchorMax = Vector2.one;
        rect.offsetMin = new Vector2(14f, 4f);
        rect.offsetMax = new Vector2(-14f, -4f);

        var tmp = go.AddComponent<TextMeshProUGUI>();
        tmp.text = "";
        tmp.fontSize = fontSize;
        tmp.color = color;
        tmp.alignment = alignment;
        tmp.fontStyle = style;
        tmp.enableWordWrapping = true;
        tmp.raycastTarget = false;

        return tmp;
    }

    private void WrapExistingToast(TMP_Text existing)
    {
        var parentImg = existing.GetComponentInParent<Image>();
        if (parentImg && parentImg.gameObject != existing.gameObject)
        {
            runtimeToastPanel = parentImg.gameObject;
        }
        else
        {
            runtimeToastPanel = new GameObject("ToastPanel");
            runtimeToastPanel.transform.SetParent(existing.transform.parent, false);

            var srcRect = existing.GetComponent<RectTransform>();
            var rect = runtimeToastPanel.AddComponent<RectTransform>();
            rect.anchorMin = srcRect.anchorMin;
            rect.anchorMax = srcRect.anchorMax;
            rect.pivot = srcRect.pivot;
            rect.anchoredPosition = srcRect.anchoredPosition;
            rect.sizeDelta = new Vector2(srcRect.sizeDelta.x + 48f, srcRect.sizeDelta.y + 24f);

            var bg = runtimeToastPanel.AddComponent<Image>();
            bg.color = new Color(0.12f, 0.12f, 0.12f, 0.92f);
            bg.raycastTarget = false;

            existing.transform.SetParent(runtimeToastPanel.transform, false);
            var newRect = existing.GetComponent<RectTransform>();
            newRect.anchorMin = Vector2.zero;
            newRect.anchorMax = Vector2.one;
            newRect.offsetMin = new Vector2(20f, 8f);
            newRect.offsetMax = new Vector2(-20f, -8f);
            newRect.anchoredPosition = Vector2.zero;
        }

        toastCanvasGroup = runtimeToastPanel.GetComponent<CanvasGroup>()
                           ?? runtimeToastPanel.AddComponent<CanvasGroup>();
    }

    // ══════════════════════════════════════════════════════════════════
    //  BUTTON STYLING
    //  Adds dark rounded backgrounds, enforces minimum touch targets,
    //  and creates simple procedural icons for buttons missing images.
    // ══════════════════════════════════════════════════════════════════

    private void StyleAllButtons()
    {
        const float MIN_SIZE = 60f;  // Material Design minimum for mobile

        StyleHudButton(openMenuButton, MIN_SIZE, "menu");
        StyleHudButton(deleteSelectedButton, MIN_SIZE, "delete");
        StyleHudButton(screenshotButton, MIN_SIZE, "camera");
        StyleCloseButton(closeMenuButton, MIN_SIZE);

        if (potSelectButtons != null)
            foreach (var btn in potSelectButtons)
                EnforceMinSize(btn, 72f);
    }

    private void StyleHudButton(Button btn, float minSize, string iconHint)
    {
        if (!btn) return;
        EnforceMinSize(btn, minSize);
        EnsureButtonBackground(btn, new Color(0.08f, 0.08f, 0.08f, 0.65f));
        EnsureProceduralIcon(btn, iconHint);
    }

    private void StyleCloseButton(Button btn, float minSize)
    {
        if (!btn) return;
        EnforceMinSize(btn, minSize);
    }

    private void EnforceMinSize(Button btn, float minPx)
    {
        if (!btn) return;
        var rect = btn.GetComponent<RectTransform>();
        if (!rect) return;
        Vector2 sd = rect.sizeDelta;
        if (sd.x > 0 && sd.x < minPx) sd.x = minPx;
        if (sd.y > 0 && sd.y < minPx) sd.y = minPx;
        rect.sizeDelta = sd;
    }

    private void EnsureButtonBackground(Button btn, Color bgColor)
    {
        // Only add background if the button doesn't already have a visible image
        var btnImg = btn.GetComponent<Image>();
        if (btnImg && btnImg.sprite != null) return; // has an icon sprite already

        if (!btnImg)
            btnImg = btn.gameObject.AddComponent<Image>();

        btnImg.color = bgColor;
        btnImg.raycastTarget = true;
    }

    private void EnsureProceduralIcon(Button btn, string iconHint)
    {
        // Skip if button already has a child image (user-assigned icon)
        var childImages = btn.GetComponentsInChildren<Image>();
        foreach (var img in childImages)
        {
            if (img.gameObject != btn.gameObject && img.sprite != null)
                return;
        }

        // Skip if button itself has a sprite
        var btnImg = btn.GetComponent<Image>();
        if (btnImg && btnImg.sprite != null) return;

        // Create procedural icon based on hint
        switch (iconHint)
        {
            case "menu":
                CreateHamburgerIcon(btn.transform, 24f, Color.white);
                break;
            case "delete":
                CreateXIcon(btn.transform, 20f, Color.white);
                break;
            case "camera":
                CreateCameraIcon(btn.transform, 22f, Color.white);
                break;
        }
    }

    // ── Procedural icon builders (simple geometric shapes) ──

    private void CreateHamburgerIcon(Transform parent, float size, Color color)
    {
        float barH = size * 0.12f;
        float gap = size * 0.3f;

        for (int i = -1; i <= 1; i++)
        {
            var bar = CreateRect(parent, "Bar" + i,
                new Vector2(size, barH), new Vector2(0f, i * gap), color);
            bar.GetComponent<Image>().raycastTarget = false;
        }
    }

    private void CreateXIcon(Transform parent, float size, Color color)
    {
        float barW = size * 1.1f;
        float barH = size * 0.16f;

        var line1 = CreateRect(parent, "X1", new Vector2(barW, barH), Vector2.zero, color);
        line1.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, 45);
        line1.GetComponent<Image>().raycastTarget = false;

        var line2 = CreateRect(parent, "X2", new Vector2(barW, barH), Vector2.zero, color);
        line2.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, -45);
        line2.GetComponent<Image>().raycastTarget = false;
    }

    private void CreateCameraIcon(Transform parent, float size, Color color)
    {
        // Camera body
        float bodyW = size * 1.2f;
        float bodyH = size * 0.8f;
        var body = CreateRect(parent, "CamBody", new Vector2(bodyW, bodyH),
                              new Vector2(0, -size * 0.05f), color);
        body.GetComponent<Image>().raycastTarget = false;

        // Lens bump (top center)
        float bumpW = size * 0.4f;
        float bumpH = size * 0.22f;
        var bump = CreateRect(parent, "CamBump", new Vector2(bumpW, bumpH),
                              new Vector2(0, bodyH * 0.5f + bumpH * 0.3f), color);
        bump.GetComponent<Image>().raycastTarget = false;

        // Lens circle (dark center dot)
        float lensSize = size * 0.35f;
        var lens = CreateRect(parent, "CamLens", new Vector2(lensSize, lensSize),
                              new Vector2(0, -size * 0.05f), new Color(0, 0, 0, 0.5f));
        lens.GetComponent<Image>().raycastTarget = false;
    }

    private void CreatePlusIcon(Transform parent, float size, Color color)
    {
        float barW = size * 1.0f;
        float barH = size * 0.18f;

        var h = CreateRect(parent, "PlusH", new Vector2(barW, barH), Vector2.zero, color);
        h.GetComponent<Image>().raycastTarget = false;

        var v = CreateRect(parent, "PlusV", new Vector2(barH, barW), Vector2.zero, color);
        v.GetComponent<Image>().raycastTarget = false;
    }

    private void CreateCheckIcon(Transform parent, float size, Color color)
    {
        float barH = size * 0.18f;

        var shortArm = CreateRect(parent, "Check1",
            new Vector2(size * 0.4f, barH), new Vector2(-size * 0.15f, -size * 0.05f), color);
        shortArm.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, -45);
        shortArm.GetComponent<Image>().raycastTarget = false;

        var longArm = CreateRect(parent, "Check2",
            new Vector2(size * 0.7f, barH), new Vector2(size * 0.15f, size * 0.1f), color);
        longArm.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, 45);
        longArm.GetComponent<Image>().raycastTarget = false;
    }

    private void UpdateSizeUI()
    {
        if (!sizeText) return;
        if (!selectedObject)
        {
            sizeText.gameObject.SetActive(false);
            return;
        }
        sizeText.gameObject.SetActive(true);
        Bounds b = GetWorldBoundsFromRenderers(selectedObject);
        Vector3 s = b.size;
        sizeText.text = $"H: {s.y * 100f:F1}cm  W: {s.x * 100f:F1}cm";
        UpdateMeasurementCard();
    }

    private GameObject CreateRect(Transform parent, string name, Vector2 size,
                                  Vector2 offset, Color color)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var rect = go.AddComponent<RectTransform>();
        rect.sizeDelta = size;
        rect.anchoredPosition = offset;
        var img = go.AddComponent<Image>();
        img.color = color;
        return go;
    }

    // ══════════════════════════════════════════════════════════════════
    //  MENU OPEN / CLOSE
    // ══════════════════════════════════════════════════════════════════

    // MENU SHEET (bottom sheet)
    private void OpenMenuSheet()
    {
        if (menuSheet != null) Destroy(menuSheet);
        menuSheet = new GameObject("MenuSheet");
        menuSheet.transform.SetParent(mainCanvas.transform, false);
        var rect = menuSheet.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0, 0);
        rect.anchorMax = new Vector2(1, 0);
        rect.pivot = new Vector2(0.5f, 0f);
        rect.anchoredPosition = new Vector2(0, 0);
        rect.sizeDelta = new Vector2(0, 340);
        var img = menuSheet.AddComponent<Image>();
        SetCard(img);
        AddShadow(menuSheet, DS.CardShadowSize, DS.CardShadowOffset);
        SetRounded(img, DS.CardRadius);
        // Title
        var titleGo = new GameObject("MenuTitle");
        titleGo.transform.SetParent(menuSheet.transform, false);
        var title = titleGo.AddComponent<TMP_Text>();
        title.text = "Choose Plant";
        title.fontSize = 20f;
        title.fontStyle = FontStyles.Bold;
        title.color = DS.TextDark;
        title.alignment = TextAlignmentOptions.TopLeft;
        title.rectTransform.anchorMin = new Vector2(0, 1);
        title.rectTransform.anchorMax = new Vector2(1, 1);
        title.rectTransform.pivot = new Vector2(0, 1);
        title.rectTransform.anchoredPosition = new Vector2(DS.Padding, -DS.Padding);
        title.rectTransform.sizeDelta = new Vector2(-DS.Padding * 2, 32);
        // Plant cards (horizontal scroll)
        var scrollGo = new GameObject("PlantScroll");
        scrollGo.transform.SetParent(menuSheet.transform, false);
        var scrollRect = scrollGo.AddComponent<RectTransform>();
        scrollRect.anchorMin = new Vector2(0, 0);
        scrollRect.anchorMax = new Vector2(1, 1);
        scrollRect.pivot = new Vector2(0.5f, 0.5f);
        scrollRect.anchoredPosition = new Vector2(0, -40);
        scrollRect.sizeDelta = new Vector2(-DS.Padding * 2, -80);
        // TODO: Add plant cards dynamically from potPrefabs
        // Done button
        var doneGo = new GameObject("MenuDoneBtn");
        doneGo.transform.SetParent(menuSheet.transform, false);
        var doneBtn = doneGo.AddComponent<Button>();
        var doneImg = doneGo.AddComponent<Image>();
        SetCard(doneImg);
        SetRounded(doneImg, DS.CardRadius);
        AddShadow(doneGo, DS.CardShadowSize * 0.7f, DS.CardShadowOffset * 0.7f);
        var doneTxt = doneGo.AddComponent<TMP_Text>();
        doneTxt.text = "Done";
        doneTxt.fontSize = 16f;
        doneTxt.color = DS.Accent;
        doneTxt.fontStyle = FontStyles.Bold;
        doneTxt.alignment = TextAlignmentOptions.Center;
        doneTxt.rectTransform.anchorMin = Vector2.zero;
        doneTxt.rectTransform.anchorMax = Vector2.one;
        doneTxt.rectTransform.offsetMin = Vector2.zero;
        doneTxt.rectTransform.offsetMax = Vector2.zero;
        doneGo.GetComponent<RectTransform>().anchorMin = new Vector2(0.5f, 0f);
        doneGo.GetComponent<RectTransform>().anchorMax = new Vector2(0.5f, 0f);
        doneGo.GetComponent<RectTransform>().pivot = new Vector2(0.5f, 0f);
        doneGo.GetComponent<RectTransform>().anchoredPosition = new Vector2(0, 18);
        doneGo.GetComponent<RectTransform>().sizeDelta = new Vector2(120, 44);
        doneBtn.onClick.RemoveAllListeners();
        doneBtn.onClick.AddListener(() => CloseMenuSheet());
        // Tap outside closes
        var overlay = new GameObject("MenuOverlay");
        overlay.transform.SetParent(mainCanvas.transform, false);
        var overlayRect = overlay.AddComponent<RectTransform>();
        overlayRect.anchorMin = Vector2.zero;
        overlayRect.anchorMax = Vector2.one;
        overlayRect.pivot = new Vector2(0.5f, 0.5f);
        overlayRect.anchoredPosition = Vector2.zero;
        overlayRect.sizeDelta = Vector2.zero;
        var overlayBtn = overlay.AddComponent<Button>();
        overlayBtn.onClick.AddListener(() => CloseMenuSheet());
        overlay.transform.SetAsFirstSibling();
        menuSheet.transform.SetAsLastSibling();
    }
    private void CloseMenuSheet()
    {
        if (menuSheet != null) Destroy(menuSheet);
        var overlay = GameObject.Find("MenuOverlay");
        if (overlay) Destroy(overlay);
    }

    private void ForceSetHudElementsVisible(bool visible)
    {
        if (openMenuButton) openMenuButton.gameObject.SetActive(visible);
        if (deleteSelectedButton) deleteSelectedButton.gameObject.SetActive(visible);
        if (screenshotButton) screenshotButton.gameObject.SetActive(visible);
        if (sizeText) sizeText.gameObject.SetActive(visible);
    }

    // ══════════════════════════════════════════════════════════════════
    //  DELETE MODE  (no placement allowed, clear visual feedback)
    // ══════════════════════════════════════════════════════════════════

    private void EnterDeleteMode()
    {
        deleteMode = true;
        if (deletePill) deletePill.SetActive(true);
        // Animate pill in (optional)
    }
    private void ExitDeleteMode()
    {
        deleteMode = false;
        if (deletePill) deletePill.SetActive(false);
    }

    private void SetObjectDeleteTint(GameObject obj, bool tinted)
    {
        var renderers = obj.GetComponentsInChildren<Renderer>();
        foreach (var r in renderers)
        {
            if (ShouldIgnoreRenderer(r)) continue;

            if (tinted)
            {
                _tintMPB.Clear();

                // Lerp toward red, preserving original hue partially
                if (r.sharedMaterial.HasProperty(PropBaseColor))
                {
                    Color c = r.sharedMaterial.GetColor(PropBaseColor);
                    _tintMPB.SetColor(PropBaseColor, Color.Lerp(c, Color.red, 0.35f));
                }
                if (r.sharedMaterial.HasProperty(PropColor))
                {
                    Color c = r.sharedMaterial.GetColor(PropColor);
                    _tintMPB.SetColor(PropColor, Color.Lerp(c, Color.red, 0.35f));
                }

                r.SetPropertyBlock(_tintMPB);
            }
            else
            {
                // Clear all overrides → reverts to original material properties
                r.SetPropertyBlock(s_ClearMPB);
            }
        }
    }

    // ══════════════════════════════════════════════════════════════════
    //  POT SELECTION
    // ══════════════════════════════════════════════════════════════════

    public void SelectPot(int index)
    {
        if (potPrefabs == null || potPrefabs.Length == 0) return;
        selectedPotIndex = Mathf.Clamp(index, 0, potPrefabs.Length - 1);

        if (potSelectButtons == null) return;
        for (int i = 0; i < potSelectButtons.Length; i++)
        {
            if (!potSelectButtons[i]) continue;
            var img = potSelectButtons[i].GetComponent<Image>();
            if (!img) continue;
            img.color = (i == selectedPotIndex)
                ? Color.white
                : new Color(1f, 1f, 1f, 0.5f);
        }
    }

    // ══════════════════════════════════════════════════════════════════
    //  GUIDANCE  (contextual hints)
    // ══════════════════════════════════════════════════════════════════

    private void UpdateGuidance()
    {
        if (!guidanceText) return;

        // Hide when menu, save dialog, or delete mode is active
        if ((menuPanel && menuPanel.activeSelf) ||
            (saveNamePanel && saveNamePanel.activeSelf) ||
            deleteMode)
        {
            SetGuidanceVisible(false);
            return;
        }

        // Check for detected horizontal planes
        bool hasPlanes = false;
        if (planeManager)
        {
            foreach (var p in planeManager.trackables)
            {
                if (p.alignment == PlaneAlignment.HorizontalUp)
                { hasPlanes = true; break; }
            }
        }

        guidanceText.text = hasPlanes
            ? "Tap on the ground or a flat surface to place the pot"
            : "Move your device slowly to detect a flat surface";

        SetGuidanceVisible(true);
    }

    private void SetGuidanceVisible(bool visible)
    {
        var target = runtimeGuidancePanel
                     ? runtimeGuidancePanel
                     : (guidanceText ? guidanceText.gameObject : null);
        if (target && target.activeSelf != visible)
            target.SetActive(visible);
    }

    // ══════════════════════════════════════════════════════════════════
    //  TOUCH INPUT  (reliable one-tap, zero GC)
    // ══════════════════════════════════════════════════════════════════

    private void HandleTouch()
    {
        // Block when overlays are visible
        if (menuPanel && menuPanel.activeSelf) return;
        if (saveNamePanel && saveNamePanel.activeSelf) return;

        // Only single-finger taps (pinch is handled separately)
        if (Input.touchCount != 1) return;

        Touch touch = Input.GetTouch(0);
        if (touch.phase != TouchPhase.Began) return;

        // ── Reject taps on UI elements ──
        if (IsPointerOverUI(touch)) return;

        // ── Debounce ──
        if (Time.unscaledTime - lastTapTime < TAP_COOLDOWN) return;
        lastTapTime = Time.unscaledTime;

        // ── Did user tap on an existing pot? ──
        Ray ray = arCamera.ScreenPointToRay(touch.position);
        if (Physics.Raycast(ray, out RaycastHit physHit, 100f))
        {
            GameObject tapped = FindSpawnedRootFromHit(physHit.collider.transform);
            if (tapped != null)
            {
                if (deleteMode)
                {
                    DeleteObject(tapped);
                    ExitDeleteMode();
                }
                else if (enableTapSelection)
                {
                    selectedObject = tapped;
                    UpdateSizeUI();
                }
                return;
            }
        }

        // ── Delete mode: tap on empty → cancel ──
        if (deleteMode)
        {
            ExitDeleteMode();
            return;
        }

        // ── Place new pot ──
        PlaceObject(touch.position);
    }

    /// <summary>
    /// Robust UI-over check: EventSystem + manual RaycastAll fallback.
    /// Uses pooled list — zero GC.
    /// </summary>
    private bool IsPointerOverUI(Touch touch)
    {
        if (EventSystem.current == null) return false;

        // Standard check
        if (EventSystem.current.IsPointerOverGameObject(touch.fingerId))
            return true;

        // Fallback: manual raycast (catches cases the standard check misses on mobile)
        var ped = new PointerEventData(EventSystem.current) { position = touch.position };
        _uiRayResults.Clear();
        EventSystem.current.RaycastAll(ped, _uiRayResults);

        for (int i = 0; i < _uiRayResults.Count; i++)
        {
            var go = _uiRayResults[i].gameObject;
            if (go.layer == 5) return true;   // UI layer = 5
            if (go.GetComponentInParent<Button>()) return true;
            if (go.GetComponentInParent<Selectable>()) return true;
        }

        return false;
    }

    private GameObject FindSpawnedRootFromHit(Transform hitTransform)
    {
        Transform t = hitTransform;
        while (t != null)
        {
            if (spawnedObjects.Contains(t.gameObject))
                return t.gameObject;
            t = t.parent;
        }
        return null;
    }

    // ══════════════════════════════════════════════════════════════════
    //  PLACEMENT
    //  ┌──────────────────────────────────────────────────────────────┐
    //  │  ARCHITECTURE (fixes drifting):                             │
    //  │                                                             │
    //  │  ARAnchor (world-tracked by AR Foundation)                  │
    //  │    └── PotObject (local transform freely adjustable)        │
    //  │                                                             │
    //  │  The pot is a CHILD of the anchor. All user transforms      │
    //  │  (scale, Y-alignment) modify the child's LOCAL transform    │
    //  │  and NEVER conflict with anchor's tracked world pose.       │
    //  │  This eliminates drift caused by fighting AR tracking.      │
    //  └──────────────────────────────────────────────────────────────┘
    // ══════════════════════════════════════════════════════════════════

    // Professional AR Foundation placement: strict plane-attached anchor, robust validation, and world-locked stability
    private void PlaceObject(Vector2 screenPosition)
    {
        if (potPrefabs == null || potPrefabs.Length == 0) return;
        GameObject prefab = potPrefabs[selectedPotIndex];
        if (!prefab) { Debug.LogError($"Pot prefab [{selectedPotIndex}] is null."); return; }

        // 1. Raycast for valid plane hit
        if (!raycastManager.Raycast(screenPosition, s_Hits, TrackableType.PlaneWithinPolygon))
        { ShowToast("Tap on a detected flat surface"); return; }

        // 2. Find best valid hit (strict validation)
        ARRaycastHit? bestHit = null;
        ARPlane hitPlane = null;
        for (int i = 0; i < s_Hits.Count; i++)
        {
            if (ValidatePlacementCandidate(s_Hits[i], out ARPlane plane))
            { bestHit = s_Hits[i]; hitPlane = plane; break; }
        }
        if (!bestHit.HasValue || hitPlane == null)
        { ShowToast("Not a valid surface \u2014 find a flat horizontal area"); return; }

        Pose hitPose = bestHit.Value.pose;

        // 3. Pre-placement stability gate (optional: dwell, jitter, etc. — can be expanded)
        // (For brevity, not implemented here, but see comments for extension)

        // 4. Compute final rotation (face camera if needed)
        Quaternion baseRot = Quaternion.identity;
        if (faceCameraOnPlace && arCamera)
        {
            Vector3 dir = arCamera.transform.position - hitPose.position;
            dir.y = 0f;
            if (dir.sqrMagnitude > 0.001f)
                baseRot = Quaternion.LookRotation(-dir.normalized);
        }
        Quaternion finalRot = baseRot * Quaternion.Euler(prefabRotationOffsetEuler);

        // 5. Create anchor attached to plane (never move after creation)
        if (!TryCreatePlacementAnchor(hitPose, hitPlane, out ARAnchor anchor))
        { ShowToast("Failed to attach anchor to plane"); return; }

        // 6. Instantiate pot as child of anchor
        GameObject obj = Instantiate(prefab, anchor.transform);
        obj.transform.localPosition = Vector3.zero;
        obj.transform.localRotation = Quaternion.identity;

        // 7. Real-world scale normalization
        Vector3 normalizedScale = Vector3.one;
        float realHeightCm = GetRealHeightForIndex(selectedPotIndex);
        if (realHeightCm > 0.01f)
            normalizedScale = NormalizeObjectToHeightCm(obj, realHeightCm);
        obj.transform.localScale = normalizedScale * defaultScale;

        // 8. Collider
        if (autoFitColliderOnPlace)
            FitBoxColliderToRenderers(obj);

        // 9. Grounding: adjust only child localPosition.y so base sits flush
        AlignObjectBottomToSurfaceLocal(obj, hitPose.position.y + yOffset);

        // 10. Store info
        var info = obj.AddComponent<PlacedPotInfo>();
        info.potIndex = selectedPotIndex;
        info.surfaceY = hitPose.position.y + yOffset;
        info.normalizedBaseScale = normalizedScale;
        info.anchorObject = anchor.gameObject;

        // 11. Track and select
        spawnedObjects.Add(obj);
        selectedObject = obj;
        UpdateMeasurementCard();
    }

    // Strict AR plane-attached anchor creation
    private bool TryCreatePlacementAnchor(Pose pose, ARPlane plane, out ARAnchor anchor)
    {
        anchor = null;
        if (anchorManager == null || plane == null) return false;
        anchor = anchorManager.AttachAnchor(plane, pose);
        return anchor != null;
    }

    // Placement candidate validation (strict)
    private bool ValidatePlacementCandidate(ARRaycastHit hit, out ARPlane plane)
    {
        plane = null;
        if (planeManager == null) return false;
        plane = planeManager.GetPlane(hit.trackableId);
        if (plane == null) return false;
        // 1. Must be horizontal-up
        if (plane.alignment != PlaneAlignment.HorizontalUp) return false;
        // 2. Must be tracking
        if (plane.trackingState != TrackingState.Tracking) return false;
        // 3. Reject bad classifications
        if (plane.classification == PlaneClassification.Wall ||
            plane.classification == PlaneClassification.Ceiling ||
            plane.classification == PlaneClassification.Door ||
            plane.classification == PlaneClassification.Window)
            return false;
        // 4. Min area (configurable, e.g. 0.04 = 20x20cm)
        float minArea = 0.04f;
        if (plane.extents.x * plane.extents.y < minArea) return false;
        // 5. Edge margin (reject hits too close to edge)
        float minEdgeDist = 0.03f; // 3cm
        if (!IsPointInsidePlanePolygonWithMargin(plane, hit.pose.position, minEdgeDist)) return false;
        // 6. Support probes (optional: can add more points for large pots)
        // 7. Anti-overlap (optional: can check for overlap with other pots)
        return true;
    }

    // Plane polygon margin check
    private bool IsPointInsidePlanePolygonWithMargin(ARPlane plane, Vector3 point, float margin)
    {
        if (plane == null || plane.boundary == null || plane.boundary.Length < 3) return false;
        Vector2 planePt = plane.transform.InverseTransformPoint(point);
        float minDist = float.MaxValue;
        var boundary = plane.boundary;
        for (int i = 0; i < boundary.Length; i++)
        {
            Vector2 a = boundary[i];
            Vector2 b = boundary[(i + 1) % boundary.Length];
            float dist = DistancePointToSegment2D(planePt, a, b);
            if (dist < minDist) minDist = dist;
        }
        return minDist > margin;
    }

    // 2D point-to-segment distance
    private float DistancePointToSegment2D(Vector2 p, Vector2 a, Vector2 b)
    {
        Vector2 ab = b - a;
        Vector2 ap = p - a;
        float t = Mathf.Clamp01(Vector2.Dot(ap, ab) / ab.sqrMagnitude);
        return Vector2.Distance(a + t * ab, p);
    }

    // Local grounding: adjust only child localPosition.y
    private void AlignObjectBottomToSurfaceLocal(GameObject obj, float surfaceY)
    {
        Physics.SyncTransforms();
        Bounds b = GetWorldBoundsFromRenderers(obj);
        if (b.size == Vector3.zero) return;
        float bottomY = b.min.y;
        float worldToLocalY = obj.transform.parent != null ? obj.transform.parent.InverseTransformPoint(new Vector3(0, bottomY, 0)).y : bottomY;
        float correction = surfaceY - b.min.y;
        obj.transform.localPosition += new Vector3(0f, correction, 0f);
    }

    private bool IsAllowedPlane(ARRaycastHit hit, out ARPlane plane)
    {
        plane = null;
        if (!planeManager) return true;

        plane = planeManager.GetPlane(hit.trackableId);
        if (!plane) return true;

        if (allowOnlyHorizontalUpPlanes && plane.alignment != PlaneAlignment.HorizontalUp)
            return false;

        if (requireFloorOrTableClassification)
        {
            PlaneClassification c = plane.classification;
            if (c != PlaneClassification.None &&
                c != PlaneClassification.Table &&
                c != PlaneClassification.Floor)
                return false;
        }

        return true;
    }

    // ══════════════════════════════════════════════════════════════════
    //  SURFACE ALIGNMENT  (zero-gap contact)
    // ══════════════════════════════════════════════════════════════════

    /// <summary>
    /// Adjusts the pot's WORLD position so its visual bottom sits exactly
    /// at the given surface Y. Works correctly whether the pot is parented
    /// to an anchor or not — it modifies the world position, which Unity
    /// converts to the appropriate local offset automatically.
    /// </summary>
    private void AlignObjectBottomToSurface(GameObject obj, float surfaceY)
    {
        // Ensure transforms are synced so renderer bounds are accurate
        Physics.SyncTransforms();

        Bounds b = GetWorldBoundsFromRenderers(obj);
        if (b.size == Vector3.zero) return;

        float bottomY = b.min.y;
        float correction = surfaceY - bottomY;

        // Apply correction to WORLD position (safe for child of anchor)
        obj.transform.position += new Vector3(0f, correction, 0f);
    }

    // ══════════════════════════════════════════════════════════════════
    //  DELETE
    // ══════════════════════════════════════════════════════════════════

    private void DeleteObject(GameObject obj)
    {
        if (!obj) return;

        if (selectedObject == obj) selectedObject = null;
        spawnedObjects.Remove(obj);

        // Clear tint before destroying (not strictly necessary but clean)
        SetObjectDeleteTint(obj, false);

        // Destroy the anchor parent (which also destroys the child pot)
        var info = obj.GetComponent<PlacedPotInfo>();
        if (info && info.anchorObject)
        {
            Destroy(info.anchorObject);
        }
        else
        {
            Destroy(obj);
        }

        UpdateMeasurementCard();
        ShowToast("Pot removed");
    }

    // ══════════════════════════════════════════════════════════════════
    //  PINCH SCALE
    // ══════════════════════════════════════════════════════════════════

    private void HandlePinchScaling()
    {
        if (Input.touchCount != 2 || !selectedObject) return;
        if (deleteMode) return; // no scaling in delete mode

        Touch t0 = Input.GetTouch(0);
        Touch t1 = Input.GetTouch(1);
        float dist = Vector2.Distance(t0.position, t1.position);

        if (t0.phase == TouchPhase.Began || t1.phase == TouchPhase.Began)
        {
            startPinchDistance = dist;
            startScale = selectedObject.transform.localScale;
            return;
        }

        if (Mathf.Approximately(startPinchDistance, 0f)) return;

        float factor = dist / startPinchDistance;
        float target = Mathf.Clamp(startScale.x * factor, minScale, maxScale);
        selectedObject.transform.localScale = Vector3.one * target;

        // Re-snap to surface after scale change
        var info = selectedObject.GetComponent<PlacedPotInfo>();
        if (info) AlignObjectBottomToSurface(selectedObject, info.surfaceY);
        
    UpdateMeasurementCard();
    }

    // ══════════════════════════════════════════════════════════════════
    //  MEASUREMENT
    // ══════════════════════════════════════════════════════════════════

    private void UpdateMeasurementCard()
    {
        if (!measurementCard) return;
        if (!selectedObject)
        {
            measurementCard.SetActive(false);
            return;
        }
        measurementCard.SetActive(true);
        Bounds b = GetWorldBoundsFromRenderers(selectedObject);
        Vector3 s = b.size;
        measurementTitle.text = "Selected Plant";
        measurementH.text = $"Height: {s.y * 100f:F1} cm";
        measurementW.text = $"Width:  {s.x * 100f:F1} cm";
        measurementD.text = $"Depth:  {s.z * 100f:F1} cm";
    }

    // ══════════════════════════════════════════════════════════════════
    //  RENDERER FILTERING + BOUNDS + COLLIDER + NORMALIZATION
    // ══════════════════════════════════════════════════════════════════

    private bool ShouldIgnoreRenderer(Renderer r)
    {
        if (!r) return true;
        if (ignoreRendererNameContains == null) return false;

        string n = r.gameObject.name.ToLowerInvariant();
        for (int i = 0; i < ignoreRendererNameContains.Length; i++)
        {
            if (string.IsNullOrEmpty(ignoreRendererNameContains[i])) continue;
            if (n.Contains(ignoreRendererNameContains[i].ToLowerInvariant()))
                return true;
        }
        return false;
    }

    private Bounds GetWorldBoundsFromRenderers(GameObject root)
    {
        var renderers = root.GetComponentsInChildren<Renderer>(true);
        Renderer first = null;

        for (int i = 0; i < renderers.Length; i++)
        {
            if (!ShouldIgnoreRenderer(renderers[i]))
            { first = renderers[i]; break; }
        }

        if (!first)
            return new Bounds(root.transform.position, Vector3.zero);

        Bounds b = first.bounds;
        for (int i = 0; i < renderers.Length; i++)
        {
            if (ShouldIgnoreRenderer(renderers[i])) continue;
            b.Encapsulate(renderers[i].bounds);
        }
        return b;
    }

    private void FitBoxColliderToRenderers(GameObject root)
    {
        Bounds world = GetWorldBoundsFromRenderers(root);
        if (world.size == Vector3.zero) return;

        BoxCollider bc = root.GetComponent<BoxCollider>();
        if (!bc) bc = root.AddComponent<BoxCollider>();

        Vector3 localCenter = root.transform.InverseTransformPoint(world.center);
        Vector3 lossy = root.transform.lossyScale;

        bc.center = localCenter;
        bc.size = new Vector3(
            lossy.x != 0 ? world.size.x / lossy.x : world.size.x,
            lossy.y != 0 ? world.size.y / lossy.y : world.size.y,
            lossy.z != 0 ? world.size.z / lossy.z : world.size.z
        );
    }

    private Vector3 NormalizeObjectToHeightCm(GameObject root, float targetHeightCm)
    {
        Bounds b = GetWorldBoundsFromRenderers(root);
        float currentHeightM = Mathf.Max(0.0001f, b.size.y);
        float targetHeightM = targetHeightCm / 100f;
        float factor = targetHeightM / currentHeightM;
        root.transform.localScale = Vector3.one * factor;
        return root.transform.localScale;
    }

    private float GetRealHeightForIndex(int index)
    {
        if (potRealHeightCm == null || index < 0 || index >= potRealHeightCm.Length)
            return 0f;
        return potRealHeightCm[index];
    }

    // ══════════════════════════════════════════════════════════════════
    //  SCREENSHOT  (hides ALL UI for clean AR-only capture)
    // ══════════════════════════════════════════════════════════════════

    private void ShowSaveNameDialog()
    {
        if (!saveNamePanel)
        {
            TakeScreenshot();
            return;
        }
        if (saveNameInput)
            saveNameInput.text = "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");
        saveNamePanel.SetActive(true);
    }

    private void ConfirmSave()
    {
        if (saveNamePanel) saveNamePanel.SetActive(false);
        string name = saveNameInput ? saveNameInput.text.Trim() : "";
        if (string.IsNullOrEmpty(name))
            name = "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");
        foreach (char c in Path.GetInvalidFileNameChars())
            name = name.Replace(c, '_');
        TakeScreenshotWithName(name);
    }

    private void CancelSave()
    {
        if (saveNamePanel) saveNamePanel.SetActive(false);
    }

    public void RenameDesign(string oldPath, string newName)
    {
        if (!File.Exists(oldPath)) { ShowToast("File not found"); return; }
        foreach (char c in Path.GetInvalidFileNameChars())
            newName = newName.Replace(c, '_');
        string dir = Path.GetDirectoryName(oldPath);
        string newPath = Path.Combine(dir, newName + ".png");
        try
        {
            File.Move(oldPath, newPath);
            ShowToast("Renamed successfully");
            onScreenshotSaved?.Invoke(newPath);
        }
        catch (Exception e)
        {
            Debug.LogError("Rename failed: " + e.Message);
            ShowToast("Rename failed");
        }
    }

    public void TakeScreenshot() => StartCoroutine(CaptureScreenshotCoroutine(null));
    public void TakeScreenshotWithName(string name) => StartCoroutine(CaptureScreenshotCoroutine(name));

    private IEnumerator CaptureScreenshotCoroutine(string customName)
    {
        // ── Snapshot current UI visibility ──
        bool menuWas     = menuPanel && menuPanel.activeSelf;
        bool hudWas      = hudRoot && hudRoot.activeSelf;
        bool guidanceWas = runtimeGuidancePanel && runtimeGuidancePanel.activeSelf;
        bool bannerWas   = runtimeDeleteBanner && runtimeDeleteBanner.activeSelf;
        bool sizeWas     = sizeText && sizeText.gameObject.activeSelf;
        bool toastWas    = runtimeToastPanel && runtimeToastPanel.activeSelf;
        bool saveWas     = saveNamePanel && saveNamePanel.activeSelf;

        // ── HIDE ALL UI ──
        SetAllUIVisible(false);

        // Wait so the screen renders clean
        yield return new WaitForEndOfFrame();

        Texture2D tex = ScreenCapture.CaptureScreenshotAsTexture();
        if (tex == null)
        {
            RestoreUIAfterScreenshot(menuWas, hudWas, guidanceWas, bannerWas,
                                     sizeWas, toastWas, saveWas);
            ShowToast("Screenshot failed");
            yield break;
        }

        byte[] png = tex.EncodeToPNG();
        Destroy(tex);

        string toastMessage;

#if UNITY_ANDROID && !UNITY_EDITOR
        string filename = (string.IsNullOrEmpty(customName)
            ? "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss")
            : customName) + ".png";
        string folder = "/storage/emulated/0/DCIM/MyDesigns/";
        try
        {
            Directory.CreateDirectory(folder);
            string galleryPath = Path.Combine(folder, filename);
            File.WriteAllBytes(galleryPath, png);

            using (var mediaScan = new AndroidJavaClass("android.media.MediaScannerConnection"))
            using (var unityPlayer = new AndroidJavaClass("com.unity3d.player.UnityPlayer"))
            using (var ctx = unityPlayer.GetStatic<AndroidJavaObject>("currentActivity"))
            {
                mediaScan.CallStatic("scanFile", ctx, new string[] { galleryPath }, null, null);
            }
            toastMessage = "Screenshot saved to gallery";
            onScreenshotSaved?.Invoke(galleryPath);
        }
        catch (Exception e)
        {
            Debug.LogError("Screenshot save failed: " + e.Message);
            toastMessage = "Screenshot save failed";
        }
#else
        string dir = Path.Combine(Application.persistentDataPath, screenshotFolderName);
        Directory.CreateDirectory(dir);
        string fn = (string.IsNullOrEmpty(customName)
            ? "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss")
            : customName) + ".png";
        string fullPath = Path.Combine(dir, fn);
        File.WriteAllBytes(fullPath, png);
        Debug.Log("Screenshot saved: " + fullPath);
        toastMessage = "Screenshot saved";
        onScreenshotSaved?.Invoke(fullPath);
#endif

        RestoreUIAfterScreenshot(menuWas, hudWas, guidanceWas, bannerWas,
                                 sizeWas, toastWas, saveWas);
        ShowToast(toastMessage);
    }

    private void SetAllUIVisible(bool visible)
    {
        if (menuPanel) menuPanel.SetActive(visible);
        if (hudRoot) hudRoot.SetActive(visible);
        ForceSetHudElementsVisible(visible);
        if (runtimeGuidancePanel) runtimeGuidancePanel.SetActive(visible);
        if (runtimeDeleteBanner) runtimeDeleteBanner.SetActive(visible);
        if (sizeText) sizeText.gameObject.SetActive(visible);
        if (runtimeToastPanel) runtimeToastPanel.SetActive(visible);
        if (saveNamePanel) saveNamePanel.SetActive(visible);
    }

    private void RestoreUIAfterScreenshot(bool menuWas, bool hudWas, bool guidanceWas,
                                           bool bannerWas, bool sizeWas, bool toastWas,
                                           bool saveWas)
    {
        if (menuPanel) menuPanel.SetActive(menuWas);
        if (hudRoot) hudRoot.SetActive(hudWas);
        if (runtimeGuidancePanel) runtimeGuidancePanel.SetActive(guidanceWas);
        if (runtimeDeleteBanner) runtimeDeleteBanner.SetActive(bannerWas);
        if (sizeText) sizeText.gameObject.SetActive(sizeWas);
        if (saveNamePanel) saveNamePanel.SetActive(saveWas);

        bool showHud = !(menuPanel && menuPanel.activeSelf);
        ForceSetHudElementsVisible(showHud);
    }

    // ══════════════════════════════════════════════════════════════════
    //  TOAST  (professional fade-animated notification)
    // ══════════════════════════════════════════════════════════════════

    private void ShowToast(string title, string subtitle = null, bool success = true)
    {
        if (!toastPanel) return;
        if (activeToastCoroutine != null)
            StopCoroutine(activeToastCoroutine);
        toastPanel.SetActive(true);
        // Remove old children
        foreach (Transform child in toastPanel.transform) Destroy(child.gameObject);
        // Icon
        var iconGo = new GameObject("ToastIcon");
        iconGo.transform.SetParent(toastPanel.transform, false);
        var iconRect = iconGo.AddComponent<RectTransform>();
        iconRect.anchorMin = new Vector2(0, 0.5f);
        iconRect.anchorMax = new Vector2(0, 0.5f);
        iconRect.pivot = new Vector2(0, 0.5f);
        iconRect.anchoredPosition = new Vector2(DS.Padding, 0);
        iconRect.sizeDelta = new Vector2(32, 32);
        var iconImg = iconGo.AddComponent<Image>();
        iconImg.color = success ? DS.Accent : DS.Danger;
        // TODO: Use premium SVG icon
        CreateCheckIcon(iconGo.transform, 24, Color.white);
        // Title
        var titleGo = new GameObject("ToastTitle");
        titleGo.transform.SetParent(toastPanel.transform, false);
        var titleTxt = titleGo.AddComponent<TMP_Text>();
        titleTxt.text = title;
        titleTxt.fontSize = 17f;
        titleTxt.fontStyle = FontStyles.Bold;
        titleTxt.color = DS.TextDark;
        titleTxt.alignment = TextAlignmentOptions.TopLeft;
        titleTxt.rectTransform.anchorMin = new Vector2(0, 0.5f);
        titleTxt.rectTransform.anchorMax = new Vector2(1, 0.5f);
        titleTxt.rectTransform.pivot = new Vector2(0, 0.5f);
        titleTxt.rectTransform.anchoredPosition = new Vector2(DS.Padding + 36, 10);
        titleTxt.rectTransform.sizeDelta = new Vector2(-DS.Padding * 2 - 36, 24);
        // Subtitle
        if (!string.IsNullOrEmpty(subtitle))
        {
            var subGo = new GameObject("ToastSubtitle");
            subGo.transform.SetParent(toastPanel.transform, false);
            var subTxt = subGo.AddComponent<TMP_Text>();
            subTxt.text = subtitle;
            subTxt.fontSize = 14f;
            subTxt.color = DS.TextSubtle;
            subTxt.alignment = TextAlignmentOptions.TopLeft;
            subTxt.rectTransform.anchorMin = new Vector2(0, 0.5f);
            subTxt.rectTransform.anchorMax = new Vector2(1, 0.5f);
            subTxt.rectTransform.pivot = new Vector2(0, 0.5f);
            subTxt.rectTransform.anchoredPosition = new Vector2(DS.Padding + 36, -12);
            subTxt.rectTransform.sizeDelta = new Vector2(-DS.Padding * 2 - 36, 20);
        }
        // Animate in/out
        var cg = toastPanel.GetComponent<CanvasGroup>() ?? toastPanel.AddComponent<CanvasGroup>();
        cg.alpha = 0f;
        activeToastCoroutine = StartCoroutine(FadeInOutAndDestroy(cg, DS.FadeIn, DS.FadeOut, 1.5f));
    }

    // Onboarding card logic
    private void ShowOnboardingCard()
    {
        if (onboardingCard) onboardingCard.SetActive(true);
    }
    private void UpdateOnboardingCard()
    {
        if (!onboardingCard) return;
        bool hasPlanes = false;
        if (planeManager)
        {
            foreach (var p in planeManager.trackables)
            {
                if (p.alignment == PlaneAlignment.HorizontalUp)
                { hasPlanes = true; break; }
            }
        }
        if (hasPlanes && onboardingCard.activeSelf)
        {
            onboardingCard.SetActive(false);
        }
    }
}
