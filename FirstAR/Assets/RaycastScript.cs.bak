    // ══════════════════════════════════════════════════════════════════
    //  LIFECYCLE
    // ══════════════════════════════════════════════════════════════════

    private void Awake()
    {
        if (!raycastManager) raycastManager = FindFirstObjectByType<ARRaycastManager>();
        if (!planeManager) planeManager = FindFirstObjectByType<ARPlaneManager>();
        if (!anchorManager) anchorManager = FindFirstObjectByType<ARAnchorManager>();
        if (!arCamera) arCamera = Camera.main;

        _tintMPB = new MaterialPropertyBlock();
        if (s_ClearMPB == null)
            s_ClearMPB = new MaterialPropertyBlock();

        EnsureRuntimeUI();
    }

    private void Start()
    {
        SelectPot(0);
        ExitDeleteMode();
        UpdateMeasurementCard();
        ShowOnboardingCard();
    }

    private void Update()
    {
        HandlePinchScaling();
        HandleTouch();
        UpdateMeasurementCard();
        UpdateOnboardingCard();
    }

    // ══════════════════════════════════════════════════════════════════
    //  UI WIRING
    // ══════════════════════════════════════════════════════════════════

    private void WireUI()
    {
        WireButton(openMenuButton, () => OpenMenuSheet());
        WireButton(closeMenuButton, () => CloseMenuSheet());
        WireButton(deleteSelectedButton, () => { if (deleteMode) ExitDeleteMode(); else EnterDeleteMode(); });
        WireButton(screenshotButton, ShowSaveNameDialog);
        WireButton(confirmSaveButton, ConfirmSave);
        WireButton(cancelSaveButton, CancelSave);

        if (potSelectButtons != null)
        {
            for (int i = 0; i < potSelectButtons.Length; i++)
            {
                int idx = i;
                WireButton(potSelectButtons[idx], () => SelectPot(idx));
            }
        }
    }

    private void WireButton(Button btn, UnityEngine.Events.UnityAction action)
    {
        if (!btn) return;
        btn.onClick.RemoveAllListeners();
        btn.onClick.AddListener(action);
    }

