    private static void SetCGState(CanvasGroup cg, bool visible)
    {
        if (!cg) return;
        cg.alpha = visible ? 1f : 0f;
        cg.interactable = visible;
        cg.blocksRaycasts = visible;
    }

    // ==============================================================
    //  LIFECYCLE
    // ==============================================================
    private void Awake()
    {
        if (!raycastManager) raycastManager = FindFirstObjectByType<ARRaycastManager>();
        if (!planeManager)   planeManager   = FindFirstObjectByType<ARPlaneManager>();
        if (!anchorManager)  anchorManager  = FindFirstObjectByType<ARAnchorManager>();
        if (!arCamera)       arCamera       = Camera.main;
        _tintMPB = new MaterialPropertyBlock();
        if (s_ClearMPB == null) s_ClearMPB = new MaterialPropertyBlock();
        EnhancedTouchSupport.Enable();
        AutoLoadPotThumbnails();
        runtimeCanvas = FindOrCreateCanvas();
        BuildAllUI();
        WireUI();
    }

    private void AutoLoadPotThumbnails()
    {
        if (potThumbnails != null && potThumbnails.Length > 0) return;
        string[] names = new string[] { "pot2", "pot2 1" };
        var list = new List<Sprite>();
        foreach (var n in names)
        {
            var tex = Resources.Load<Texture2D>("potsphoto/" + n);
            if (tex != null)
                list.Add(Sprite.Create(tex,
                    new Rect(0, 0, tex.width, tex.height),
                    new Vector2(0.5f, 0.5f)));
        }
        if (list.Count > 0) potThumbnails = list.ToArray();
    }

    private void Start()
    {
        SelectPot(0);
        SetMenuOpen(false);
        SetDeleteMode(false);
        if (runtimeToastPanel) runtimeToastPanel.SetActive(false);
        if (previewBtnsContainer) previewBtnsContainer.SetActive(false);
    }

    private void Update()
    {
        HandleTouch();
        HandlePinchScaling();
        UpdatePreviewGhost();
        UpdateOnboarding();
        UpdateMeasureCard();
    }

    // ==============================================================
    //  CANVAS
    // ==============================================================
    private Canvas FindOrCreateCanvas()
    {
        // Detach any existing EventSystem from Canvas hierarchy BEFORE disabling canvases
        var existingES = FindFirstObjectByType<EventSystem>(FindObjectsInactive.Include);
        if (existingES != null)
            existingES.transform.SetParent(null);

        var old = FindObjectsByType<Canvas>(FindObjectsSortMode.None);
        foreach (var c in old) c.gameObject.SetActive(false);

        if (EventSystem.current == null)
        {
            if (existingES != null) existingES.gameObject.SetActive(true);
            else
            {
                var esGo = new GameObject("EventSystem");
                esGo.AddComponent<EventSystem>();
                esGo.AddComponent<UnityEngine.InputSystem.UI.InputSystemUIInputModule>();
            }
        }
        var go = new GameObject("ARCanvas");
        var canvas = go.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 100;
        var scaler = go.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1080, 2340);
        scaler.matchWidthOrHeight = 0.5f;
        go.AddComponent<GraphicRaycaster>();
        return canvas;
    }

    // ==============================================================
    //  BUILD ALL UI
    // ==============================================================
    private void BuildAllUI()
    {
        Transform root = runtimeCanvas.transform;
        BuildBottomBar(root);
        BuildGuidancePanel(root);
        BuildToastPanel(root);
        BuildDeleteBanner(root);
        BuildMenuOverlay(root);
        BuildPreviewButtons(root);
        BuildMeasureCard(root);
    }

    private void BuildBottomBar(Transform root)
    {
        float barW = 280f, barH = 64f;
        float sideBtn = 46f, centerBtn = 56f, spread = 78f;
        float barBottomY = 40f;

        bottomBar = new GameObject("BottomBar");
        bottomBar.transform.SetParent(root, false);
        AddRect(bottomBar,
            new Vector2(0.5f, 0), new Vector2(0.5f, 0), new Vector2(0.5f, 0),
            new Vector2(0, barBottomY), new Vector2(barW, barH));
        bottomBarCG = bottomBar.AddComponent<CanvasGroup>();
        SetCGState(bottomBarCG, true);

        MakeShadowLayer(bottomBar.transform, -10, -8, 10, 6, C_SHADOW_S);
        MakeShadowLayer(bottomBar.transform, -4, -3, 4, 2, C_SHADOW);

        var pillGO = new GameObject("Pill");
        pillGO.transform.SetParent(bottomBar.transform, false);
        var prt = pillGO.AddComponent<RectTransform>();
        prt.anchorMin = Vector2.zero; prt.anchorMax = Vector2.one;
        prt.offsetMin = Vector2.zero; prt.offsetMax = Vector2.zero;
        var pi = pillGO.AddComponent<Image>();
        pi.color = C_BAR_BG;
        pi.raycastTarget = true;

        bottomDeleteButton = MakeBarBtn(
            bottomBar.transform, "TrashBtn", sideBtn, Color.clear,
            new Vector2(-spread, 0));
        MakeMinimalTrashIcon(bottomDeleteButton.transform, 24f, C_ICON);

        MakeRect(bottomBar.transform, "PlusShadow",
            new Vector2(centerBtn + 6, centerBtn + 6),
            new Vector2(0, 3), C_SHADOW);
        bottomMenuButton = MakeBarBtn(
            bottomBar.transform, "PlusBtn", centerBtn, Color.white,
            new Vector2(0, 5));
        MakeMinimalPlusIcon(bottomMenuButton.transform, 26f, C_ICON_DARK);

        bottomCameraButton = MakeBarBtn(
            bottomBar.transform, "CamBtn", sideBtn, Color.clear,
            new Vector2(spread, 0));
        MakeMinimalCameraIcon(bottomCameraButton.transform, 24f, C_ICON);
    }

    private void BuildGuidancePanel(Transform root)
    {
        float cW = 260f, cH = 68f;
        onboardingCard = new GameObject("OnboardCard");
        onboardingCard.transform.SetParent(root, false);
        AddRect(onboardingCard,
            new Vector2(0.5f, 0.5f), new Vector2(0.5f, 0.5f),
            new Vector2(0.5f, 0.5f),
            new Vector2(0, -36), new Vector2(cW, cH));
        MakeShadowLayer(onboardingCard.transform, -8, -7, 8, 5, C_SHADOW_S);
        MakeShadowLayer(onboardingCard.transform, -3, -3, 3, 2, C_SHADOW);

        var cardBg = onboardingCard.AddComponent<Image>();
        cardBg.color = C_SURFACE;
        cardBg.raycastTarget = false;
        onboardingCardCG = onboardingCard.AddComponent<CanvasGroup>();
        SetCGState(onboardingCardCG, true);

        var labelGO = new GameObject("ScanLabel");
        labelGO.transform.SetParent(onboardingCard.transform, false);
        AddRect(labelGO, Vector2.zero, Vector2.one,
            new Vector2(0.5f, 0.5f), Vector2.zero, Vector2.zero);
        var lblTMP = labelGO.AddComponent<TextMeshProUGUI>();
        lblTMP.text = "Scan your space";
        lblTMP.fontSize = FS_TITLE;
        lblTMP.color = C_TEXT_SEC;
        lblTMP.alignment = TextAlignmentOptions.Center;
        lblTMP.enableWordWrapping = false;
        lblTMP.raycastTarget = false;
        onboardingCard.SetActive(true);

        runtimeGuidancePanel = new GameObject("GuidePanel");
        runtimeGuidancePanel.transform.SetParent(root, false);
        AddRect(runtimeGuidancePanel,
            new Vector2(0.25f, 0), new Vector2(0.75f, 0),
            new Vector2(0.5f, 0),
            new Vector2(0, 130), new Vector2(0, 42));
        MakeShadowLayer(runtimeGuidancePanel.transform, -4, -3, 4, 2, C_SHADOW_S);
        var bgI = runtimeGuidancePanel.AddComponent<Image>();
        bgI.color = C_SURFACE;
        bgI.raycastTarget = false;
        guidanceText = MakeTMP(runtimeGuidancePanel.transform,
            "GuideTxt", "", FS_BODY, C_TEXT_PRI,
            TextAlignmentOptions.Center,
            new Vector2(SP_M, SP_S), new Vector2(-SP_M, -SP_S));
        runtimeGuidancePanel.SetActive(false);
    }

    private void BuildToastPanel(Transform root)
    {
        float safeTop = (Screen.height - Screen.safeArea.yMax)
                        / runtimeCanvas.scaleFactor;
        float topInset = Mathf.Max(safeTop, 12f) + SP_M;
        float cardW = 340f, cardH = 76f;

        runtimeToastPanel = new GameObject("ToastCard");
        runtimeToastPanel.transform.SetParent(root, false);
        toastRT = AddRect(runtimeToastPanel,
            new Vector2(0.5f, 1), new Vector2(0.5f, 1), new Vector2(0.5f, 1),
            new Vector2(0, -(topInset + cardH * 0.5f)),
            new Vector2(cardW, cardH));
        toastCanvasGroup = runtimeToastPanel.AddComponent<CanvasGroup>();
        SetCGState(toastCanvasGroup, false);

        MakeShadowLayer(runtimeToastPanel.transform, -8, -7, 8, 5, C_SHADOW_S);
        MakeShadowLayer(runtimeToastPanel.transform, -3, -3, 3, 2, C_SHADOW);

        var bgGO = new GameObject("BG");
        bgGO.transform.SetParent(runtimeToastPanel.transform, false);
        var brt = bgGO.AddComponent<RectTransform>();
        brt.anchorMin = Vector2.zero; brt.anchorMax = Vector2.one;
        brt.offsetMin = Vector2.zero; brt.offsetMax = Vector2.zero;
        var bgImg = bgGO.AddComponent<Image>();
        bgImg.color = C_SURFACE;
        bgImg.raycastTarget = false;

        var iconGO = new GameObject("Icon");
        iconGO.transform.SetParent(runtimeToastPanel.transform, false);
        var irt = iconGO.AddComponent<RectTransform>();
        irt.anchorMin = new Vector2(0, 0);
        irt.anchorMax = new Vector2(0, 1);
        irt.pivot = new Vector2(0, 0.5f);
        irt.offsetMin = new Vector2(SP_M, 0);
        irt.offsetMax = new Vector2(SP_M + 36f, 0);
        toastIconTMP = iconGO.AddComponent<TextMeshProUGUI>();
        toastIconTMP.fontSize = 24f;
        toastIconTMP.color = C_TEXT_PRI;
        toastIconTMP.alignment = TextAlignmentOptions.Center;
        toastIconTMP.raycastTarget = false;

        float textLeft = SP_M + 40f;
        var titleGO = new GameObject("Title");
        titleGO.transform.SetParent(runtimeToastPanel.transform, false);
        var trt = titleGO.AddComponent<RectTransform>();
        trt.anchorMin = new Vector2(0, 0.48f);
        trt.anchorMax = Vector2.one;
        trt.offsetMin = new Vector2(textLeft, 0);
        trt.offsetMax = new Vector2(-SP_M, -SP_S);
        toastTitleTMP = titleGO.AddComponent<TextMeshProUGUI>();
        toastTitleTMP.fontSize = 15f;
        toastTitleTMP.fontStyle = FontStyles.Bold;
        toastTitleTMP.color = C_TEXT_PRI;
        toastTitleTMP.alignment = TextAlignmentOptions.BottomLeft;
        toastTitleTMP.enableWordWrapping = false;
        toastTitleTMP.raycastTarget = false;

        var subGO = new GameObject("Subtitle");
        subGO.transform.SetParent(runtimeToastPanel.transform, false);
        var surt = subGO.AddComponent<RectTransform>();
        surt.anchorMin = Vector2.zero;
        surt.anchorMax = new Vector2(1, 0.48f);
        surt.offsetMin = new Vector2(textLeft, SP_S);
        surt.offsetMax = new Vector2(-SP_M, 0);
        toastSubtitleTMP = subGO.AddComponent<TextMeshProUGUI>();
        toastSubtitleTMP.fontSize = FS_CAPTION;
        toastSubtitleTMP.color = C_TEXT_TER;
        toastSubtitleTMP.alignment = TextAlignmentOptions.TopLeft;
        toastSubtitleTMP.enableWordWrapping = false;
        toastSubtitleTMP.raycastTarget = false;

        runtimeToastPanel.SetActive(false);
    }

    private void BuildDeleteBanner(Transform root)
    {
        float safeTop = (Screen.height - Screen.safeArea.yMax)
                        / runtimeCanvas.scaleFactor;
        float topInset = Mathf.Max(safeTop, 12f) + SP_M;
        float hW = 220f, hH = 44f;

        runtimeDeleteBanner = new GameObject("DeleteHint");
        runtimeDeleteBanner.transform.SetParent(root, false);
        AddRect(runtimeDeleteBanner,
            new Vector2(0.5f, 1), new Vector2(0.5f, 1), new Vector2(0.5f, 1),
            new Vector2(0, -(topInset + hH * 0.5f)),
            new Vector2(hW, hH));
        MakeShadowLayer(runtimeDeleteBanner.transform, -5, -4, 5, 3, C_SHADOW_S);
        var bg = runtimeDeleteBanner.AddComponent<Image>();
        bg.color = C_SURFACE;
        bg.raycastTarget = false;
        MakeTMP(runtimeDeleteBanner.transform,
            "DelTxt", "Tap a pot to remove", FS_BODY,
            C_DEL_TEXT,
            TextAlignmentOptions.Center,
            new Vector2(SP_M, SP_XS), new Vector2(-SP_M, -SP_XS));
        runtimeDeleteBanner.SetActive(false);
        deleteBannerCG = runtimeDeleteBanner.AddComponent<CanvasGroup>();
        SetCGState(deleteBannerCG, false);
    }

    private void BuildMenuOverlay(Transform root)
    {
        float sheetH = 400f;

        runtimeMenuOverlay = new GameObject("MenuOverlay");
        runtimeMenuOverlay.transform.SetParent(root, false);
        var mr = AddRect(runtimeMenuOverlay,
            Vector2.zero, Vector2.one, new Vector2(.5f, .5f),
            Vector2.zero, Vector2.zero);
        mr.offsetMin = Vector2.zero;
        mr.offsetMax = Vector2.zero;
        menuOverlayCG = runtimeMenuOverlay.AddComponent<CanvasGroup>();
        SetCGState(menuOverlayCG, false);

        var scrimGO = new GameObject("Scrim");
        scrimGO.transform.SetParent(runtimeMenuOverlay.transform, false);
        var scrimRT = AddRect(scrimGO,
            Vector2.zero, Vector2.one, new Vector2(.5f, .5f),
            Vector2.zero, Vector2.zero);
        scrimRT.offsetMin = Vector2.zero;
        scrimRT.offsetMax = Vector2.zero;
        var scrimImg = scrimGO.AddComponent<Image>();
        scrimImg.color = C_OVERLAY;
        scrimImg.raycastTarget = true;
        var scrimBtn = scrimGO.AddComponent<Button>();
        scrimBtn.targetGraphic = scrimImg;
        SetBtnCol(scrimBtn, Color.clear, Color.clear, Color.clear);
        NavNone(scrimBtn);
        scrimBtn.onClick.AddListener(() => SetMenuOpen(false));

        var sheetGO = new GameObject("Sheet");
        sheetGO.transform.SetParent(runtimeMenuOverlay.transform, false);
        menuSheetRT = AddRect(sheetGO,
            new Vector2(0, 0), new Vector2(1, 0), new Vector2(0.5f, 0),
            Vector2.zero, new Vector2(0, sheetH));
        menuSheetRT.offsetMin = new Vector2(0, 0);
        menuSheetRT.offsetMax = new Vector2(0, sheetH);
        var sheetBg = sheetGO.AddComponent<Image>();
        sheetBg.color = C_SURFACE;
        sheetBg.raycastTarget = true;

        var handleGO = new GameObject("Handle");
        handleGO.transform.SetParent(sheetGO.transform, false);
        AddRect(handleGO,
            new Vector2(0.5f, 1), new Vector2(0.5f, 1), new Vector2(0.5f, 1),
            new Vector2(0, -12), new Vector2(36, 4));
        var handleImg = handleGO.AddComponent<Image>();
        handleImg.color = new Color(0.82f, 0.82f, 0.84f);
        handleImg.raycastTarget = false;

        var titleGO = new GameObject("Title");
        titleGO.transform.SetParent(sheetGO.transform, false);
        AddRect(titleGO,
            new Vector2(0, 1), new Vector2(1, 1), new Vector2(0, 1),
            new Vector2(SP_L, -50), new Vector2(-SP_L * 2, 48));
        var titleTMP = titleGO.AddComponent<TextMeshProUGUI>();
        titleTMP.text = "Choose Plant";
        titleTMP.fontSize = FS_HEADING;
        titleTMP.color = C_TEXT_PRI;
        titleTMP.fontStyle = FontStyles.Bold;
        titleTMP.alignment = TextAlignmentOptions.MidlineLeft;
        titleTMP.enableWordWrapping = false;
        titleTMP.raycastTarget = false;

        var scrollGO = new GameObject("Scroll");
        scrollGO.transform.SetParent(sheetGO.transform, false);
        var scrollRT = AddRect(scrollGO,
            new Vector2(0, 0), new Vector2(1, 1), new Vector2(0.5f, 0.5f),
            new Vector2(0, 16), new Vector2(0, -56));
        scrollRT.offsetMin = new Vector2(0, 16);
        scrollRT.offsetMax = new Vector2(0, -56);
        var scrollImg = scrollGO.AddComponent<Image>();
        scrollImg.color = Color.clear;
        scrollImg.raycastTarget = true;
        scrollGO.AddComponent<Mask>().showMaskGraphic = false;
        var sr = scrollGO.AddComponent<ScrollRect>();
        sr.horizontal = true;
        sr.vertical = false;
        sr.movementType = ScrollRect.MovementType.Elastic;
        sr.elasticity = 0.1f;
        sr.scrollSensitivity = 20f;

        var contentGO = new GameObject("Content");
        contentGO.transform.SetParent(scrollGO.transform, false);
        var contentRT = AddRect(contentGO,
            new Vector2(0, 0), new Vector2(0, 1), new Vector2(0, 0.5f),
            Vector2.zero, Vector2.zero);
        contentRT.pivot = new Vector2(0, 0.5f);
        var hlg = contentGO.AddComponent<HorizontalLayoutGroup>();
        hlg.childAlignment = TextAnchor.MiddleLeft;
        hlg.spacing = 14f;
        hlg.childForceExpandWidth = false;
        hlg.childForceExpandHeight = false;
        hlg.padding = new RectOffset(16, 16, 8, 8);
        var csf = contentGO.AddComponent<ContentSizeFitter>();
        csf.horizontalFit = ContentSizeFitter.FitMode.PreferredSize;
        csf.verticalFit = ContentSizeFitter.FitMode.Unconstrained;
        sr.content = contentRT;
        sr.viewport = scrollRT;

        int count = (potPrefabs != null) ? potPrefabs.Length : 0;
        for (int i = 0; i < count; i++)
        {
            int idx = i;
            float cardW = 156f, cardH = 220f;

            var card = new GameObject("PlantCard_" + i);
            card.transform.SetParent(contentGO.transform, false);
            var crtCard = card.AddComponent<RectTransform>();
            crtCard.sizeDelta = new Vector2(cardW, cardH);
            var le = card.AddComponent<LayoutElement>();
            le.preferredWidth = cardW;
            le.preferredHeight = cardH;
            le.minWidth = cardW;
            le.minHeight = cardH;

            MakeShadowLayer(card.transform, -6, -5, 6, 4, C_SHADOW_S);
            MakeShadowLayer(card.transform, -2, -2, 2, 1, C_SHADOW);

            var cardBgImg = card.AddComponent<Image>();
            cardBgImg.color = Color.white;
            cardBgImg.raycastTarget = true;

            var btn = card.AddComponent<Button>();
            btn.targetGraphic = cardBgImg;
            SetBtnCol(btn, Color.white,
                new Color(0.97f, 0.97f, 0.97f),
                new Color(0.93f, 0.93f, 0.93f));
            NavNone(btn);
            btn.onClick.AddListener(() =>
            {
                SelectPot(idx);
                StartCoroutine(AnimTapScale(card.transform));
            });

            Sprite spr = (potImages != null && idx < potImages.Length)
                ? potImages[idx] : null;
            if (spr == null && potThumbnails != null && idx < potThumbnails.Length)
                spr = potThumbnails[idx];

            if (spr)
            {
                var imgGO = new GameObject("PlantImg");
                imgGO.transform.SetParent(card.transform, false);
                AddRect(imgGO,
                    new Vector2(0.08f, 0.26f), new Vector2(0.92f, 0.94f),
                    new Vector2(0.5f, 0.5f), Vector2.zero, Vector2.zero);
                var plantImg = imgGO.AddComponent<Image>();
                plantImg.sprite = spr;
                plantImg.preserveAspect = true;
                plantImg.raycastTarget = false;
            }
            else
            {
                var emojiGO = new GameObject("Emoji");
                emojiGO.transform.SetParent(card.transform, false);
                AddRect(emojiGO,
                    new Vector2(0.1f, 0.30f), new Vector2(0.9f, 0.85f),
                    new Vector2(0.5f, 0.5f), Vector2.zero, Vector2.zero);
                var emojiTMP = emojiGO.AddComponent<TextMeshProUGUI>();
                emojiTMP.text = "\U0001FAB4";
                emojiTMP.fontSize = 44f;
                emojiTMP.alignment = TextAlignmentOptions.Center;
                emojiTMP.enableWordWrapping = false;
                emojiTMP.raycastTarget = false;
            }

            string pName = GetPotDisplayName(idx);
            var nameGO = new GameObject("Name");
            nameGO.transform.SetParent(card.transform, false);
            AddRect(nameGO,
                new Vector2(0, 0.02f), new Vector2(1, 0.22f),
                new Vector2(0.5f, 0.5f),
                new Vector2(SP_S, 0), new Vector2(-SP_S, 0));
            var nameTMP = nameGO.AddComponent<TextMeshProUGUI>();
            nameTMP.text = pName;
            nameTMP.fontSize = 13f;
            nameTMP.color = C_TEXT_SEC;
            nameTMP.alignment = TextAlignmentOptions.Center;
            nameTMP.enableWordWrapping = true;
            nameTMP.raycastTarget = false;
        }

        runtimeMenuOverlay.SetActive(false);
    }

    private void BuildPreviewButtons(Transform root)
    {
        previewBtnsContainer = new GameObject("PreviewBtns");
        previewBtnsContainer.transform.SetParent(root, false);
        AddRect(previewBtnsContainer,
            new Vector2(.5f, 0), new Vector2(.5f, 0), new Vector2(.5f, 0),
            new Vector2(0, 44), new Vector2(300, 80));
        previewBtnsCG = previewBtnsContainer.AddComponent<CanvasGroup>();
        SetCGState(previewBtnsCG, false);

        var hlgComp = previewBtnsContainer.AddComponent<HorizontalLayoutGroup>();
        hlgComp.childAlignment = TextAnchor.MiddleCenter;
        hlgComp.spacing = SP_XL;
        hlgComp.childForceExpandWidth = false;
        hlgComp.childForceExpandHeight = false;

        previewCancelBtn = MakePillIconBtn(
            previewBtnsContainer.transform, "PrvCancel", 60f, C_GLASS);
        MakeMinimalXIcon(previewCancelBtn.transform, 22f, C_WHITE70);

        previewConfirmBtn = MakePillIconBtn(
            previewBtnsContainer.transform, "PrvConfirm", 60f, C_WHITE);
        MakeMinimalCheckIcon(previewConfirmBtn.transform, 24f, C_TEXT_PRI);

        previewBtnsContainer.SetActive(false);
    }

    private void BuildMeasureCard(Transform root)
    {
        measureCard = new GameObject("MeasureCard");
        measureCard.transform.SetParent(root, false);
        AddRect(measureCard,
            new Vector2(0, 1), new Vector2(0, 1), new Vector2(0, 1),
            new Vector2(SP_M, -SP_M), new Vector2(220f, 140f));
        MakeShadowLayer(measureCard.transform, -6, -5, 6, 4, C_SHADOW_S);
        MakeShadowLayer(measureCard.transform, -2, -2, 2, 1, C_SHADOW);
        var bg = measureCard.AddComponent<Image>();
        bg.color = C_SURFACE_L;
        bg.raycastTarget = false;

        var mtGo = new GameObject("MT");
        mtGo.transform.SetParent(measureCard.transform, false);
        var mtRT = mtGo.AddComponent<RectTransform>();
        mtRT.anchorMin = new Vector2(0, 1);
        mtRT.anchorMax = new Vector2(1, 1);
        mtRT.pivot = new Vector2(0, 1);
        mtRT.anchoredPosition = new Vector2(SP_M, -SP_S);
        mtRT.sizeDelta = new Vector2(-SP_M * 2, 22);
        measureTitle = mtGo.AddComponent<TextMeshProUGUI>();
        measureTitle.fontSize = 16f;
        measureTitle.fontStyle = FontStyles.Bold;
        measureTitle.color = C_TEXT_PRI;
        measureTitle.alignment = TextAlignmentOptions.TopLeft;
        measureTitle.enableWordWrapping = false;
        measureTitle.raycastTarget = false;

        measureH = MakeMeasureLine(measureCard.transform, "MH", -44);
        measureW = MakeMeasureLine(measureCard.transform, "MW", -66);
        measureD = MakeMeasureLine(measureCard.transform, "MD", -88);

        measureCard.SetActive(false);
    }

    private TMP_Text MakeMeasureLine(Transform parent, string name, float yPos)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var rt = go.AddComponent<RectTransform>();
        rt.anchorMin = new Vector2(0, 1);
        rt.anchorMax = new Vector2(1, 1);
        rt.pivot = new Vector2(0, 1);
        rt.anchoredPosition = new Vector2(SP_M, yPos);
        rt.sizeDelta = new Vector2(-SP_M * 2, 22);
        var tmp = go.AddComponent<TextMeshProUGUI>();
        tmp.fontSize = 14f;
        tmp.color = C_TEXT_PRI;
        tmp.alignment = TextAlignmentOptions.Left;
        tmp.enableWordWrapping = false;
        tmp.raycastTarget = false;
        return tmp;
    }

    // ==============================================================
    //  UI WIRING
    // ==============================================================
    private void WireUI()
    {
        if (bottomDeleteButton)
            bottomDeleteButton.onClick.AddListener(() => SetDeleteMode(!deleteMode));
        if (bottomMenuButton)
            bottomMenuButton.onClick.AddListener(() => SetMenuOpen(true));
        if (bottomCameraButton)
            bottomCameraButton.onClick.AddListener(() => TakeScreenshot());
        if (previewConfirmBtn)
            previewConfirmBtn.onClick.AddListener(OnConfirmPlace);
        if (previewCancelBtn)
            previewCancelBtn.onClick.AddListener(OnCancelPlace);
    }

    // ==============================================================
    //  MENU OPEN / CLOSE (animated sheet)
    // ==============================================================
    private void SetMenuOpen(bool open)
    {
        if (open)
        {
            if (isPreviewMode) ExitPreviewMode();
            if (runtimeMenuOverlay) runtimeMenuOverlay.SetActive(true);
            StartCoroutine(AnimateMenuSheet(true));
        }
        else
        {
            if (runtimeMenuOverlay && runtimeMenuOverlay.activeSelf)
                StartCoroutine(AnimateMenuSheet(false));
        }
        if (bottomBar) bottomBar.SetActive(!open);
        if (open) SetDeleteMode(false);
    }

    private IEnumerator AnimateMenuSheet(bool opening)
    {
        float dur = opening ? 0.25f : 0.18f;
        float sheetH = menuSheetRT ? menuSheetRT.offsetMax.y : 400f;
        float e = 0f;

        if (!opening && menuOverlayCG)
        {
            menuOverlayCG.interactable = false;
            menuOverlayCG.blocksRaycasts = false;
        }

        while (e < dur)
        {
            e += Time.unscaledDeltaTime;
            float t = Mathf.SmoothStep(0, 1, Mathf.Clamp01(e / dur));
            if (!opening) t = 1f - t;

            if (menuSheetRT)
            {
                float h = Mathf.Lerp(0, sheetH, t);
                menuSheetRT.offsetMax = new Vector2(0, h);
            }
            if (menuOverlayCG) menuOverlayCG.alpha = t;
            yield return null;
        }

        if (opening)
        {
            if (menuSheetRT) menuSheetRT.offsetMax = new Vector2(0, sheetH);
            SetCGState(menuOverlayCG, true);
        }
        else
        {
            SetCGState(menuOverlayCG, false);
            if (runtimeMenuOverlay) runtimeMenuOverlay.SetActive(false);
        }
    }

    // ==============================================================
    //  DELETE MODE
    // ==============================================================
    private void SetDeleteMode(bool on)
    {
        deleteMode = on;
        if (isPreviewMode) ExitPreviewMode();

        if (runtimeDeleteBanner)
        {
            if (on)
            {
                runtimeDeleteBanner.SetActive(true);
                StartCoroutine(FadeCG(deleteBannerCG, 0, 1, 0.2f));
            }
            else
            {
                StartCoroutine(FadeOutDisable(deleteBannerCG, runtimeDeleteBanner, 0.15f));
            }
        }

        foreach (var obj in spawnedObjects)
            if (obj) SetObjectDeleteTint(obj, on);
    }

    private void SetObjectDeleteTint(GameObject obj, bool tinted)
    {
        foreach (var r in obj.GetComponentsInChildren<Renderer>())
        {
            if (ShouldIgnoreRenderer(r)) continue;
            if (tinted)
            {
                _tintMPB.Clear();
                if (r.sharedMaterial && r.sharedMaterial.HasProperty(PropBaseColor))
                    _tintMPB.SetColor(PropBaseColor,
                        Color.Lerp(r.sharedMaterial.GetColor(PropBaseColor), C_DEL_TINT, 0.35f));
                if (r.sharedMaterial && r.sharedMaterial.HasProperty(PropColor))
                    _tintMPB.SetColor(PropColor,
                        Color.Lerp(r.sharedMaterial.GetColor(PropColor), C_DEL_TINT, 0.35f));
                r.SetPropertyBlock(_tintMPB);
            }
            else
            {
                r.SetPropertyBlock(s_ClearMPB);
            }
        }
    }

    private void DeleteObject(GameObject obj)
    {
        if (!obj) return;
        if (selectedObject == obj) selectedObject = null;
        spawnedObjects.Remove(obj);
        SetObjectDeleteTint(obj, false);
        var info = obj.GetComponent<PlacedPotInfo>();
        if (info && info.anchorObject) Destroy(info.anchorObject);
        else Destroy(obj);
        spawnedObjects.RemoveAll(o => o == null);
        ShowToast("\u2139", "Removed", "");
    }

    // ==============================================================
    //  POT SELECTION
    // ==============================================================
    public void SelectPot(int index)
    {
        if (potPrefabs == null || potPrefabs.Length == 0) return;
        selectedPotIndex = Mathf.Clamp(index, 0, potPrefabs.Length - 1);
        SetMenuOpen(false);
    }

    // ==============================================================
    //  ONBOARDING / GUIDANCE
    // ==============================================================
    private void UpdateOnboarding()
    {
        bool blocked = (runtimeMenuOverlay && runtimeMenuOverlay.activeSelf) || deleteMode;
        if (blocked)
        {
            if (onboardingCard && onboardingCard.activeSelf) onboardingCard.SetActive(false);
            if (runtimeGuidancePanel && runtimeGuidancePanel.activeSelf) runtimeGuidancePanel.SetActive(false);
            return;
        }

        if (isPreviewMode)
        {
            if (onboardingCard && onboardingCard.activeSelf) onboardingCard.SetActive(false);
            if (runtimeGuidancePanel && !runtimeGuidancePanel.activeSelf) runtimeGuidancePanel.SetActive(true);
            if (guidanceText)
            {
                if (previewIsStable)
                { guidanceText.text = "Tap \u2713 to place"; guidanceText.color = C_GOOD; }
                else if (lastPoseValid)
                { guidanceText.text = "Hold steady"; guidanceText.color = C_WARN; }
                else
                { guidanceText.text = "Point at a surface"; guidanceText.color = C_ERROR; }
            }
            return;
        }

        if (runtimeGuidancePanel && runtimeGuidancePanel.activeSelf)
            runtimeGuidancePanel.SetActive(false);

        if (!onboardingDismissed && planeManager)
        {
            bool hasPlanes = false;
            foreach (var p in planeManager.trackables)
                if (p.alignment == PlaneAlignment.HorizontalUp) { hasPlanes = true; break; }
            if (hasPlanes)
            {
                onboardingDismissed = true;
                StartCoroutine(DismissOnboardingCard());
            }
        }
    }

    private IEnumerator DismissOnboardingCard()
    {
        if (onboardingCardCG)
        {
            onboardingCardCG.interactable = false;
            onboardingCardCG.blocksRaycasts = false;
        }
        float dur = 0.4f, e = 0f;
        while (e < dur)
        {
            e += Time.deltaTime;
            float a = 1f - Mathf.SmoothStep(0, 1, e / dur);
            if (onboardingCardCG) onboardingCardCG.alpha = a;
            yield return null;
        }
        SetCGState(onboardingCardCG, false);
        if (onboardingCard) onboardingCard.SetActive(false);
    }

    // ==============================================================
    //  MEASURE CARD UPDATE
    // ==============================================================
    private void UpdateMeasureCard()
    {
        if (!measureCard) return;
        if (!selectedObject || isPreviewMode)
        {
            if (measureCard.activeSelf) measureCard.SetActive(false);
            return;
        }
        if (!measureCard.activeSelf) measureCard.SetActive(true);
        Bounds b = GetWorldBoundsFromRenderers(selectedObject);
        Vector3 s = b.size;
        var info = selectedObject.GetComponent<PlacedPotInfo>();
        string nm = "Plant";
        if (info != null && potNames != null && info.potIndex < potNames.Length)
            nm = potNames[info.potIndex];
        if (measureTitle) measureTitle.text = nm;
        if (measureH) measureH.text = string.Format("H  {0:F1} cm", s.y * 100f);
        if (measureW) measureW.text = string.Format("W  {0:F1} cm", s.x * 100f);
        if (measureD) measureD.text = string.Format("D  {0:F1} cm", s.z * 100f);
    }

    // ==============================================================
    //  TOUCH INPUT
    // ==============================================================
    private void HandleTouch()
    {
        if (runtimeMenuOverlay && runtimeMenuOverlay.activeSelf) return;
        if (isPreviewMode) return;

        Vector2 tapPos = Vector2.zero;
        bool hasTap = false;

        // New Input System touch
        var touches = ETouch.activeTouches;
        if (touches.Count == 1
            && touches[0].phase == UnityEngine.InputSystem.TouchPhase.Began)
        {
            tapPos = touches[0].screenPosition;
            hasTap = true;
        }

#if UNITY_EDITOR
        // Mouse fallback for editor Play Mode testing
        if (!hasTap && Mouse.current != null
            && Mouse.current.leftButton.wasPressedThisFrame)
        {
            tapPos = Mouse.current.position.ReadValue();
            hasTap = true;
        }
#endif

        if (!hasTap) return;
        if (IsPointerOverUI(tapPos)) return;
        if (Time.unscaledTime - lastTapTime < TAP_COOLDOWN) return;
        lastTapTime = Time.unscaledTime;

        Ray ray = arCamera.ScreenPointToRay(tapPos);
        if (Physics.Raycast(ray, out RaycastHit physHit, 100f))
        {
            GameObject tapped = FindSpawnedRootFromHit(physHit.collider.transform);
            if (tapped != null)
            {
                if (deleteMode) { DeleteObject(tapped); SetDeleteMode(false); }
                else if (enableTapSelection) selectedObject = tapped;
                return;
            }
        }
        if (deleteMode) { SetDeleteMode(false); return; }
        EnterPreviewMode();
    }

    private bool IsPointerOverUI(Vector2 screenPos)
    {
        if (EventSystem.current == null) return false;
        if (EventSystem.current.IsPointerOverGameObject()) return true;
        var ped = new PointerEventData(EventSystem.current) { position = screenPos };
        _uiRayResults.Clear();
        EventSystem.current.RaycastAll(ped, _uiRayResults);
        for (int i = 0; i < _uiRayResults.Count; i++)
        {
            var go = _uiRayResults[i].gameObject;
            if (go.layer == 5) return true;
            if (go.GetComponentInParent<Button>()) return true;
        }
        return false;
    }

    private GameObject FindSpawnedRootFromHit(Transform hit)
    {
        Transform t = hit;
        while (t != null)
        {
            if (spawnedObjects.Contains(t.gameObject)) return t.gameObject;
            t = t.parent;
        }
        return null;
    }

    // ==============================================================
    //  PREVIEW MODE
    // ==============================================================
    private void EnterPreviewMode()
    {
        if (isPreviewMode) return;
        isPreviewMode = true;
        lastPoseValid = false;
        lastValidPlane = null;
        previewIsStable = false;
        previewStableTime = 0f;
        if (potPrefabs == null || selectedPotIndex >= potPrefabs.Length) return;
        var prefab = potPrefabs[selectedPotIndex];
        if (!prefab) return;
        previewGhost = Instantiate(prefab);
        previewGhost.name = "PreviewGhost";
        float realH = GetRealHeightForIndex(selectedPotIndex);
        if (realH > 0.01f) NormalizeObjectToHeightCm(previewGhost, realH);
        previewGhost.transform.localScale *= defaultScale;
        SetGhostTransparency(previewGhost, 0.45f);
        foreach (var col in previewGhost.GetComponentsInChildren<Collider>()) Destroy(col);
        previewGhost.SetActive(false);
        StartCoroutine(TransitionToPreview());
    }

    private void ExitPreviewMode()
    {
        isPreviewMode = false;
        lastPoseValid = false;
        lastValidPlane = null;
        previewIsStable = false;
        if (previewGhost) Destroy(previewGhost);
        previewGhost = null;
        StartCoroutine(TransitionFromPreview());
    }

    private IEnumerator TransitionToPreview()
    {
        if (bottomBar && bottomBar.activeSelf)
        {
            if (bottomBarCG) { bottomBarCG.interactable = false; bottomBarCG.blocksRaycasts = false; }
            float d = 0.15f, e = 0f;
            while (e < d)
            {
                e += Time.unscaledDeltaTime;
                if (bottomBarCG) bottomBarCG.alpha = 1f - Mathf.Clamp01(e / d);
                yield return null;
            }
            bottomBar.SetActive(false);
            SetCGState(bottomBarCG, false);
        }

        if (previewBtnsContainer)
        {
            previewBtnsContainer.SetActive(true);
            SetCGState(previewBtnsCG, false);
            previewBtnsContainer.transform.localScale = Vector3.one * 0.85f;
            float d = 0.2f, e = 0f;
            while (e < d)
            {
                e += Time.unscaledDeltaTime;
                float t = Mathf.SmoothStep(0, 1, Mathf.Clamp01(e / d));
                if (previewBtnsCG) previewBtnsCG.alpha = t;
                previewBtnsContainer.transform.localScale = Vector3.one * Mathf.Lerp(0.85f, 1f, t);
                yield return null;
            }
            SetCGState(previewBtnsCG, true);
            previewBtnsContainer.transform.localScale = Vector3.one;
        }
    }

    private IEnumerator TransitionFromPreview()
    {
        if (previewBtnsContainer && previewBtnsContainer.activeSelf)
        {
            if (previewBtnsCG) { previewBtnsCG.interactable = false; previewBtnsCG.blocksRaycasts = false; }
            float d = 0.12f, e = 0f;
            while (e < d)
            {
                e += Time.unscaledDeltaTime;
                if (previewBtnsCG) previewBtnsCG.alpha = 1f - Mathf.Clamp01(e / d);
                yield return null;
            }
            previewBtnsContainer.SetActive(false);
            SetCGState(previewBtnsCG, false);
        }

        if (bottomBar)
        {
            bottomBar.SetActive(true);
            SetCGState(bottomBarCG, false);
            float d = 0.2f, e = 0f;
            while (e < d)
            {
                e += Time.unscaledDeltaTime;
                float t = Mathf.SmoothStep(0, 1, Mathf.Clamp01(e / d));
                if (bottomBarCG) bottomBarCG.alpha = t;
                yield return null;
            }
            SetCGState(bottomBarCG, true);
        }
    }

    private void UpdatePreviewGhost()
    {
        if (!isPreviewMode || !previewGhost) return;
        previewFoundThisFrame = false;
        Vector2 center = new Vector2(Screen.width * 0.5f, Screen.height * 0.5f);
        if (raycastManager.Raycast(center, s_Hits, TrackableType.PlaneWithinPolygon))
        {
            for (int i = 0; i < s_Hits.Count; i++)
            {
                if (ValidatePreviewCandidate(s_Hits[i], out ARPlane plane))
                {
                    lastValidPose = s_Hits[i].pose;
                    lastValidPlane = plane;
                    lastPoseValid = true;
                    previewFoundThisFrame = true;
                    break;
                }
            }
        }

        if (!previewFoundThisFrame)
        {
            lastPoseValid = false;
            lastValidPlane = null;
            previewIsStable = false;
            previewGhost.SetActive(false);
            return;
        }

        previewGhost.SetActive(true);
        Vector3 targetPos = lastValidPose.position + new Vector3(0, yOffset, 0);
        previewGhost.transform.position = targetPos;
        if (faceCameraOnPlace && arCamera)
        {
            Vector3 dir = arCamera.transform.position - lastValidPose.position;
            dir.y = 0;
            if (dir.sqrMagnitude > 0.001f)
                previewGhost.transform.rotation =
                    Quaternion.LookRotation(-dir.normalized)
                    * Quaternion.Euler(prefabRotationOffsetEuler);
        }
        GroundPreviewGhost();

        if (Vector3.Distance(targetPos, previewLastStablePos) > JITTER_THRESHOLD)
        {
            previewLastStablePos = targetPos;
            previewStableTime = Time.unscaledTime;
            previewIsStable = false;
        }
        else if (!previewIsStable && Time.unscaledTime - previewStableTime >= DWELL_TIME)
        {
            previewIsStable = true;
        }
    }

    private bool ValidatePreviewCandidate(ARRaycastHit hit, out ARPlane plane)
    {
        plane = null;
        if (planeManager == null) return false;
        plane = planeManager.GetPlane(hit.trackableId);
        if (plane == null) return false;
        if (plane.alignment != PlaneAlignment.HorizontalUp) return false;
        if (plane.trackingState == TrackingState.None) return false;
        var c = plane.classification;
        if (c == PlaneClassification.Wall || c == PlaneClassification.Ceiling
            || c == PlaneClassification.Door || c == PlaneClassification.Window)
            return false;
        if (ComputePolygonArea(plane) < 0.04f) return false;
        if (!IsPointInsidePlane(plane, hit.pose.position)) return false;
        return true;
    }

    private void GroundPreviewGhost()
    {
        if (!previewGhost) return;
        Physics.SyncTransforms();
        Bounds b = GetWorldBoundsFromRenderers(previewGhost);
        if (b.size == Vector3.zero) return;
        float surfaceY = lastValidPose.position.y + yOffset;
        previewGhost.transform.position += new Vector3(0f, surfaceY - b.min.y, 0f);
    }

    private void OnConfirmPlace()
    {
        if (!isPreviewMode || !lastPoseValid || !previewFoundThisFrame) return;
        if (!previewIsStable) return;
        if (lastValidPlane == null || lastValidPlane.trackingState != TrackingState.Tracking)
        { ShowToast("\u26A0", "Surface lost", ""); return; }

        Bounds ghostBounds = GetWorldBoundsFromRenderers(previewGhost);
        float ghostRadius = Mathf.Max(ghostBounds.extents.x, ghostBounds.extents.z);
        foreach (var existing in spawnedObjects)
        {
            if (!existing) continue;
            Bounds eb = GetWorldBoundsFromRenderers(existing);
            float existRadius = Mathf.Max(eb.extents.x, eb.extents.z);
            float minDist = ghostRadius + existRadius + MIN_POT_SPACING;
            Vector3 dv = lastValidPose.position - eb.center;
            dv.y = 0;
            if (dv.magnitude < minDist)
            { ShowToast("\u26A0", "Too close to another pot", ""); return; }
        }

        if (!IsFootprintSupported(lastValidPlane, lastValidPose.position, ghostRadius))
        { ShowToast("\u26A0", "Surface too small", ""); return; }

        PlaceObjectAtPose(lastValidPose, lastValidPlane);
        ExitPreviewMode();
    }

    private void OnCancelPlace() { ExitPreviewMode(); }

    private void SetGhostTransparency(GameObject obj, float alpha)
    {
        foreach (var r in obj.GetComponentsInChildren<Renderer>())
        {
            foreach (var mat in r.materials)
            {
                Color c = mat.HasProperty(PropBaseColor) ? mat.GetColor(PropBaseColor) : Color.white;
                c.a = alpha;
                if (mat.HasProperty(PropBaseColor)) mat.SetColor(PropBaseColor, c);
                if (mat.HasProperty(PropColor)) mat.SetColor(PropColor, c);
                mat.SetFloat("_Surface", 1);
                mat.SetOverrideTag("RenderType", "Transparent");
                mat.renderQueue = 3000;
                mat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
                mat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
                mat.SetInt("_ZWrite", 0);
                mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
            }
        }
    }

    // ==============================================================
    //  PLACEMENT
    // ==============================================================
    private void PlaceObjectAtPose(Pose hitPose, ARPlane hitPlane)
    {
        if (potPrefabs == null || potPrefabs.Length == 0) return;
        GameObject prefab = potPrefabs[selectedPotIndex];
        if (!prefab) return;

        if (hitPlane == null || hitPlane.trackingState != TrackingState.Tracking)
        { ShowToast("\u26A0", "Surface lost", ""); return; }

        if (!TryCreatePlacementAnchor(hitPose, hitPlane, out ARAnchor anchor))
        { ShowToast("\u26A0", "Failed to anchor", ""); return; }

        GameObject obj = Instantiate(prefab, anchor.transform);
        obj.transform.localPosition = Vector3.zero;
        obj.transform.localRotation = Quaternion.identity;

        Vector3 normScale = Vector3.one;
        float realH = GetRealHeightForIndex(selectedPotIndex);
        if (realH > 0.01f) normScale = NormalizeObjectToHeightCm(obj, realH);
        obj.transform.localScale = normScale * defaultScale;

        if (faceCameraOnPlace && arCamera)
        {
            Vector3 dir = arCamera.transform.position - hitPose.position;
            dir.y = 0f;
            if (dir.sqrMagnitude > 0.001f)
                obj.transform.rotation = Quaternion.LookRotation(-dir.normalized)
                    * Quaternion.Euler(prefabRotationOffsetEuler);
        }

        if (autoFitColliderOnPlace) FitBoxColliderToRenderers(obj);
        GroundChildToAnchorSurface(obj);

        var info = obj.AddComponent<PlacedPotInfo>();
        info.potIndex = selectedPotIndex;
        info.surfaceY = hitPose.position.y + yOffset;
        info.normalizedBaseScale = normScale;
        info.anchorObject = anchor.gameObject;

        spawnedObjects.Add(obj);
        selectedObject = obj;
        string nm = GetPotDisplayName(selectedPotIndex);
        ShowToast("\u2705", nm + " placed", "");
    }

    // ==============================================================
    //  AR HELPERS
    // ==============================================================
    private bool TryCreatePlacementAnchor(Pose pose, ARPlane plane, out ARAnchor anchor)
    {
        anchor = null;
        if (anchorManager == null || plane == null) return false;
        anchor = anchorManager.AttachAnchor(plane, pose);
        return anchor != null;
    }

    private float ComputePolygonArea(ARPlane plane)
    {
        if (plane == null || plane.boundary.Length < 3) return 0f;
        var bnd = plane.boundary;
        float area = 0f;
        int n = bnd.Length;
        for (int i = 0; i < n; i++)
        {
            Vector2 a = bnd[i], b = bnd[(i + 1) % n];
            area += a.x * b.y - b.x * a.y;
        }
        return Mathf.Abs(area) * 0.5f;
    }

    private bool IsPointInsidePlane(ARPlane plane, Vector3 worldPoint)
    {
        if (plane == null || plane.boundary.Length < 3) return false;
        Vector3 local3 = plane.transform.InverseTransformPoint(worldPoint);
        Vector2 pt = new Vector2(local3.x, local3.z);
        var bnd = plane.boundary;
        int n = bnd.Length;
        bool inside = false;
        for (int i = 0, j = n - 1; i < n; j = i++)
        {
            Vector2 a = bnd[i], b = bnd[j];
            if (((a.y <= pt.y && pt.y < b.y) || (b.y <= pt.y && pt.y < a.y))
                && pt.x < (b.x - a.x) * (pt.y - a.y) / (b.y - a.y) + a.x)
                inside = !inside;
        }
        return inside;
    }

    private bool IsFootprintSupported(ARPlane plane, Vector3 center, float radius)
    {
        if (plane == null) return false;
        float probeR = Mathf.Max(radius - FOOTPRINT_MARGIN, 0.01f);
        for (int i = 0; i < FOOTPRINT_PROBES; i++)
        {
            float angle = (2f * Mathf.PI * i) / FOOTPRINT_PROBES;
            Vector3 probe = center + new Vector3(
                Mathf.Cos(angle) * probeR, 0f, Mathf.Sin(angle) * probeR);
            if (!IsPointInsidePlane(plane, probe)) return false;
        }
        return true;
    }

    private void GroundChildToAnchorSurface(GameObject obj)
    {
        Physics.SyncTransforms();
        Bounds b = GetWorldBoundsFromRenderers(obj);
        if (b.size == Vector3.zero) return;
        Transform anchor = obj.transform.parent;
        float anchorY = anchor != null ? anchor.position.y : obj.transform.position.y;
        float surfaceY = anchorY + yOffset;
        float bottomOffset = b.min.y - obj.transform.position.y;
        Vector3 lp = obj.transform.localPosition;
        lp.y = (surfaceY - anchor.position.y) - bottomOffset;
        obj.transform.localPosition = lp;
    }

    // ==============================================================
    //  PINCH SCALE
    // ==============================================================
    private void HandlePinchScaling()
    {
        var touches = ETouch.activeTouches;
        if (touches.Count != 2 || !selectedObject || deleteMode) return;
        var t0 = touches[0];
        var t1 = touches[1];
        float dist = Vector2.Distance(t0.screenPosition, t1.screenPosition);
        if (t0.phase == UnityEngine.InputSystem.TouchPhase.Began
            || t1.phase == UnityEngine.InputSystem.TouchPhase.Began)
        { startPinchDistance = dist; startScale = selectedObject.transform.localScale; return; }
        if (Mathf.Approximately(startPinchDistance, 0f)) return;
        float ratio = dist / startPinchDistance;
        var info = selectedObject.GetComponent<PlacedPotInfo>();
        Vector3 baseScale = info != null ? info.normalizedBaseScale : Vector3.one;
        float currentFactor = startScale.x / Mathf.Max(baseScale.x, 0.0001f);
        float targetFactor = Mathf.Clamp(currentFactor * ratio, minScale, maxScale);
        selectedObject.transform.localScale = baseScale * targetFactor;
        if (info != null && selectedObject.transform.parent != null)
            GroundChildToAnchorSurface(selectedObject);
    }

    // ==============================================================
    //  RENDERER / BOUNDS / COLLIDER
    // ==============================================================
    private bool ShouldIgnoreRenderer(Renderer r)
    {
        if (!r) return true;
        if (ignoreRendererNameContains == null) return false;
        string n = r.gameObject.name.ToLowerInvariant();
        foreach (var s in ignoreRendererNameContains)
            if (!string.IsNullOrEmpty(s) && n.Contains(s.ToLowerInvariant())) return true;
        return false;
    }

    private Bounds GetWorldBoundsFromRenderers(GameObject root)
    {
        var rends = root.GetComponentsInChildren<Renderer>(true);
        Renderer first = null;
        foreach (var r in rends) if (!ShouldIgnoreRenderer(r)) { first = r; break; }
        if (!first) return new Bounds(root.transform.position, Vector3.zero);
        Bounds b = first.bounds;
        foreach (var r in rends) { if (!ShouldIgnoreRenderer(r)) b.Encapsulate(r.bounds); }
        return b;
    }

    private void FitBoxColliderToRenderers(GameObject root)
    {
        Bounds w = GetWorldBoundsFromRenderers(root);
        if (w.size == Vector3.zero) return;
        BoxCollider bc = root.GetComponent<BoxCollider>() ?? root.AddComponent<BoxCollider>();
        bc.center = root.transform.InverseTransformPoint(w.center);
        Vector3 ls = root.transform.lossyScale;
        bc.size = new Vector3(
            ls.x != 0 ? w.size.x / ls.x : w.size.x,
            ls.y != 0 ? w.size.y / ls.y : w.size.y,
            ls.z != 0 ? w.size.z / ls.z : w.size.z);
    }

    private Vector3 NormalizeObjectToHeightCm(GameObject root, float targetCm)
    {
        Bounds b = GetWorldBoundsFromRenderers(root);
        float f = (targetCm / 100f) / Mathf.Max(0.0001f, b.size.y);
        root.transform.localScale = Vector3.one * f;
        return root.transform.localScale;
    }

    private float GetRealHeightForIndex(int i)
    {
        if (potRealHeightCm == null || i < 0 || i >= potRealHeightCm.Length) return 0f;
        return potRealHeightCm[i];
    }

    private string GetPotDisplayName(int idx)
    {
        if (potNames != null && idx >= 0 && idx < potNames.Length && !string.IsNullOrEmpty(potNames[idx]))
            return potNames[idx];
        if (potPrefabs != null && idx >= 0 && idx < potPrefabs.Length && potPrefabs[idx])
        {
            string raw = potPrefabs[idx].name.Replace("(Clone)", "").Replace("_", " ").Trim();
            if (raw.Length > 0) raw = char.ToUpper(raw[0]) + raw.Substring(1);
            return raw;
        }
        return "Plant";
    }

    // ==============================================================
    //  SCREENSHOT
    // ==============================================================
    public void TakeScreenshot() => StartCoroutine(CaptureCoroutine());

    private IEnumerator CaptureCoroutine()
    {
        bool barW = bottomBar && bottomBar.activeSelf;
        bool measW = measureCard && measureCard.activeSelf;
        bool delW = runtimeDeleteBanner && runtimeDeleteBanner.activeSelf;
        bool toastW = runtimeToastPanel && runtimeToastPanel.activeSelf;
        bool onbW = onboardingCard && onboardingCard.activeSelf;
        bool confW = previewBtnsContainer && previewBtnsContainer.activeSelf;
        bool guideW = runtimeGuidancePanel && runtimeGuidancePanel.activeSelf;

        if (bottomBar) bottomBar.SetActive(false);
        if (measureCard) measureCard.SetActive(false);
        if (runtimeDeleteBanner) runtimeDeleteBanner.SetActive(false);
        if (runtimeToastPanel) runtimeToastPanel.SetActive(false);
        if (onboardingCard) onboardingCard.SetActive(false);
        if (previewBtnsContainer) previewBtnsContainer.SetActive(false);
        if (runtimeGuidancePanel) runtimeGuidancePanel.SetActive(false);

        yield return new WaitForEndOfFrame();
        Texture2D tex = ScreenCapture.CaptureScreenshotAsTexture();
        if (tex == null)
        {
            RestoreUI(barW, measW, delW, toastW, onbW, confW, guideW);
            ShowToast("\u26A0", "Capture failed", "");
            yield break;
        }
        byte[] png = tex.EncodeToPNG(); Destroy(tex);
        string msg;
#if UNITY_ANDROID && !UNITY_EDITOR
        string fn = "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".png";
        string folder = "/storage/emulated/0/DCIM/MyDesigns/";
        try
        {
            Directory.CreateDirectory(folder);
            string p = Path.Combine(folder, fn);
            File.WriteAllBytes(p, png);
            using (var ms = new AndroidJavaClass("android.media.MediaScannerConnection"))
            using (var up = new AndroidJavaClass("com.unity3d.player.UnityPlayer"))
            using (var ctx = up.GetStatic<AndroidJavaObject>("currentActivity"))
                ms.CallStatic("scanFile", ctx, new string[]{p}, null, null);
            msg = "Saved to gallery";
            onScreenshotSaved?.Invoke(p);
        }
        catch (Exception e) { Debug.LogError("Screenshot: " + e.Message); msg = "Save failed"; }
#else
        string dir = Path.Combine(Application.persistentDataPath, screenshotFolderName);
        Directory.CreateDirectory(dir);
        string fp = Path.Combine(dir, "MyDesign_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".png");
        File.WriteAllBytes(fp, png);
        msg = "Screenshot saved";
        onScreenshotSaved?.Invoke(fp);
#endif
        RestoreUI(barW, measW, delW, toastW, onbW, confW, guideW);
        ShowToast("\ud83d\udcf8", msg, "Snapshot saved successfully");
    }

    private void RestoreUI(bool bar, bool meas, bool del, bool toast, bool onb, bool conf, bool guide)
    {
        if (bottomBar) bottomBar.SetActive(bar);
        if (measureCard) measureCard.SetActive(meas);
        if (runtimeDeleteBanner) runtimeDeleteBanner.SetActive(del);
        if (runtimeToastPanel) runtimeToastPanel.SetActive(toast);
        if (onboardingCard) onboardingCard.SetActive(onb);
        if (previewBtnsContainer) previewBtnsContainer.SetActive(conf);
        if (runtimeGuidancePanel) runtimeGuidancePanel.SetActive(guide);
    }

    // ==============================================================
    //  PREMIUM TOAST (animated slide-in)
    // ==============================================================
    private void ShowToast(string icon, string title, string subtitle)
    {
        if (!runtimeToastPanel) return;
        if (activeToastCoroutine != null) StopCoroutine(activeToastCoroutine);
        if (toastIconTMP) toastIconTMP.text = icon;
        if (toastTitleTMP) toastTitleTMP.text = title;
        if (toastSubtitleTMP) toastSubtitleTMP.text = subtitle;
        activeToastCoroutine = StartCoroutine(AnimatedToast());
    }

    private IEnumerator AnimatedToast()
    {
        runtimeToastPanel.SetActive(true);
        float restY = toastRT.anchoredPosition.y;
        float startY = restY + 60f;
        toastCanvasGroup.alpha = 0;
        toastCanvasGroup.interactable = false;
        toastCanvasGroup.blocksRaycasts = false;

        for (float t = 0; t < 0.20f; t += Time.unscaledDeltaTime)
        {
            float p = Mathf.SmoothStep(0, 1, t / 0.20f);
            toastCanvasGroup.alpha = p;
            toastRT.anchoredPosition = new Vector2(toastRT.anchoredPosition.x, Mathf.Lerp(startY, restY, p));
            yield return null;
        }
        SetCGState(toastCanvasGroup, true);
        toastRT.anchoredPosition = new Vector2(toastRT.anchoredPosition.x, restY);

        yield return new WaitForSecondsRealtime(2f);

        toastCanvasGroup.interactable = false;
        toastCanvasGroup.blocksRaycasts = false;
        for (float t = 0; t < 0.25f; t += Time.unscaledDeltaTime)
        {
            float p = Mathf.SmoothStep(1, 0, t / 0.25f);
            toastCanvasGroup.alpha = p;
            toastRT.anchoredPosition = new Vector2(toastRT.anchoredPosition.x, Mathf.Lerp(startY, restY, p));
            yield return null;
        }
        SetCGState(toastCanvasGroup, false);
        runtimeToastPanel.SetActive(false);
        activeToastCoroutine = null;
    }

    // ==============================================================
    //  UI FACTORY HELPERS
    // ==============================================================
    private RectTransform AddRect(GameObject go,
        Vector2 aMin, Vector2 aMax, Vector2 piv, Vector2 aPos, Vector2 sD)
    {
        var rr = go.GetComponent<RectTransform>();
        if (!rr) rr = go.AddComponent<RectTransform>();
        rr.anchorMin = aMin; rr.anchorMax = aMax; rr.pivot = piv;
        rr.anchoredPosition = aPos; rr.sizeDelta = sD;
        return rr;
    }

    private TMP_Text MakeTMP(Transform parent, string name, string text,
        float fs, Color c, TextAlignmentOptions align, Vector2 oMin, Vector2 oMax)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var rr = go.AddComponent<RectTransform>();
        rr.anchorMin = Vector2.zero; rr.anchorMax = Vector2.one;
        rr.offsetMin = oMin; rr.offsetMax = oMax;
        var tmp = go.AddComponent<TextMeshProUGUI>();
        tmp.text = text; tmp.fontSize = fs; tmp.color = c;
        tmp.alignment = align;
        tmp.enableWordWrapping = true; tmp.raycastTarget = false;
        return tmp;
    }

    private GameObject MakeRect(Transform parent, string name,
        Vector2 size, Vector2 off, Color c)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var rr = go.AddComponent<RectTransform>();
        rr.anchorMin = new Vector2(.5f, .5f); rr.anchorMax = new Vector2(.5f, .5f);
        rr.sizeDelta = size; rr.anchoredPosition = off;
        var img = go.AddComponent<Image>();
        img.color = c; img.raycastTarget = false;
        return go;
    }

    private void MakeShadowLayer(Transform parent,
        float oMinX, float oMinY, float oMaxX, float oMaxY, Color c)
    {
        var sh = new GameObject("Shadow");
        sh.transform.SetParent(parent, false);
        var shRT = sh.AddComponent<RectTransform>();
        shRT.anchorMin = Vector2.zero; shRT.anchorMax = Vector2.one;
        shRT.offsetMin = new Vector2(oMinX, oMinY);
        shRT.offsetMax = new Vector2(oMaxX, oMaxY);
        var shImg = sh.AddComponent<Image>();
        shImg.color = c; shImg.raycastTarget = false;
    }

    private Button MakeBarBtn(Transform parent, string name,
        float sz, Color bgCol, Vector2 pos)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var rt = go.AddComponent<RectTransform>();
        rt.anchorMin = new Vector2(0.5f, 0.5f); rt.anchorMax = new Vector2(0.5f, 0.5f);
        rt.sizeDelta = new Vector2(sz, sz); rt.anchoredPosition = pos;
        var bg = go.AddComponent<Image>();
        bg.color = bgCol; bg.raycastTarget = true;
        var btn = go.AddComponent<Button>();
        btn.targetGraphic = bg;
        SetBtnCol(btn, Color.white, new Color(.96f, .96f, .96f), new Color(.90f, .90f, .90f));
        NavNone(btn);
        return btn;
    }

    private Button MakePillIconBtn(Transform parent, string name, float sz, Color bgCol)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        go.AddComponent<RectTransform>().sizeDelta = new Vector2(sz, sz);
        var le = go.AddComponent<LayoutElement>();
        le.preferredWidth = sz; le.preferredHeight = sz;
        var bg = go.AddComponent<Image>();
        bg.color = bgCol; bg.raycastTarget = true;
        var btn = go.AddComponent<Button>();
        btn.targetGraphic = bg;
        SetBtnCol(btn, Color.white, new Color(.95f, .95f, .95f), new Color(.82f, .82f, .82f));
        NavNone(btn);
        return btn;
    }

    private void SetBtnCol(Button b, Color n, Color h, Color p)
    {
        var cb = b.colors; cb.normalColor = n; cb.highlightedColor = h;
        cb.pressedColor = p; cb.fadeDuration = .08f; b.colors = cb;
    }

    private void NavNone(Button b)
    {
        var nav = b.navigation; nav.mode = Navigation.Mode.None; b.navigation = nav;
    }

    // ==============================================================
    //  MINIMAL ICON HELPERS
    // ==============================================================
    private void MakeMinimalTrashIcon(Transform parent, float sz, Color c)
    {
        float top = sz * 0.24f;
        MakeRect(parent, "TH", new Vector2(sz * 0.26f, sz * 0.11f), new Vector2(0, top + sz * 0.10f), c);
        MakeRect(parent, "TL", new Vector2(sz * 0.78f, sz * 0.09f), new Vector2(0, top), c);
        MakeRect(parent, "TB", new Vector2(sz * 0.58f, sz * 0.56f), new Vector2(0, top - sz * 0.36f), c);
    }

    private void MakeMinimalPlusIcon(Transform parent, float sz, Color c)
    {
        float arm = sz * 0.85f, t = sz * 0.18f;
        MakeRect(parent, "PH", new Vector2(arm, t), Vector2.zero, c);
        MakeRect(parent, "PV", new Vector2(t, arm), Vector2.zero, c);
    }

    private void MakeMinimalCameraIcon(Transform parent, float sz, Color c)
    {
        float bW = sz * 1.0f, bH = sz * 0.65f;
        MakeRect(parent, "Body", new Vector2(bW, bH), new Vector2(0, -sz * 0.02f), c);
        MakeRect(parent, "Bump", new Vector2(sz * 0.30f, sz * 0.14f), new Vector2(0, bH * 0.5f + sz * 0.04f), c);
        MakeRect(parent, "Lens", new Vector2(sz * 0.28f, sz * 0.28f), new Vector2(0, -sz * 0.02f), new Color(0, 0, 0, 0.35f));
    }

    private void MakeMinimalXIcon(Transform parent, float sz, Color c)
    {
        float w = sz, h = sz * 0.14f;
        var l1 = MakeRect(parent, "X1", new Vector2(w, h), Vector2.zero, c);
        l1.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, 45);
        var l2 = MakeRect(parent, "X2", new Vector2(w, h), Vector2.zero, c);
        l2.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, -45);
    }

    private void MakeMinimalCheckIcon(Transform parent, float sz, Color c)
    {
        float t = sz * 0.15f;
        var a1 = MakeRect(parent, "ChkL", new Vector2(sz * 0.60f, t), new Vector2(sz * 0.14f, sz * 0.04f), c);
        a1.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, 45);
        var a2 = MakeRect(parent, "ChkS", new Vector2(sz * 0.36f, t), new Vector2(-sz * 0.10f, -sz * 0.02f), c);
        a2.GetComponent<RectTransform>().localRotation = Quaternion.Euler(0, 0, -45);
    }

    // ==============================================================
    //  ANIMATION HELPERS
    // ==============================================================
    private IEnumerator FadeCG(CanvasGroup cg, float from, float to, float dur)
    {
        if (!cg) yield break;
        cg.alpha = from;
        if (to > from) { cg.interactable = true; cg.blocksRaycasts = true; }
        float e = 0;
        while (e < dur)
        {
            e += Time.unscaledDeltaTime;
            cg.alpha = Mathf.Lerp(from, to, e / dur);
            yield return null;
        }
        SetCGState(cg, to > 0.5f);
    }

    private IEnumerator FadeOutDisable(CanvasGroup cg, GameObject target, float dur)
    {
        if (cg)
        {
            cg.interactable = false; cg.blocksRaycasts = false;
            float e = 0;
            while (e < dur) { e += Time.unscaledDeltaTime; cg.alpha = 1 - e / dur; yield return null; }
            cg.alpha = 0;
        }
        if (target) target.SetActive(false);
    }

    private IEnumerator AnimTapScale(Transform t)
    {
        if (!t) yield break;
        Vector3 orig = t.localScale;
        for (float e = 0; e < 0.06f; e += Time.unscaledDeltaTime)
        { t.localScale = Vector3.LerpUnclamped(orig, orig * 0.95f, e / 0.06f); yield return null; }
        t.localScale = orig * 0.95f;
        for (float e = 0; e < 0.14f; e += Time.unscaledDeltaTime)
        {
            float p = e / 0.14f;
            float s = 0.95f + 0.05f * p + 0.03f * Mathf.Sin(p * Mathf.PI);
            t.localScale = orig * s;
            yield return null;
        }
        t.localScale = orig;
    }
}
