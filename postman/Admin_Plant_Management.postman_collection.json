              "host": ["{{base_url}}"],
              "path": ["api", "admin", "plants"],
              "query": [
                {"key": "page", "value": "0"},
                {"key": "size", "value": "10"},
                {"key": "sort", "value": "nameAr,asc"}
              ]
            }
          }
        },
