    {
      "name": "🖼️ Plant Images",
      "item": [
        {
          "name": "Add Image to Plant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set('image_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"https://example.com/tomato-harvest.jpg\",\n  \"altTextAr\": \"حصاد الطماطم\",\n  \"altTextEn\": \"Tomato harvest\",\n  \"isPrimary\": false,\n  \"displayOrder\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/plants/{{plant_id}}/images",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "plants", "{{plant_id}}", "images"]
            }
          }
        },
        {
          "name": "Set Primary Image",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/plants/{{plant_id}}/images/{{image_id}}/primary",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "plants", "{{plant_id}}", "images", "{{image_id}}", "primary"]
            }
          }
        },
        {
          "name": "Reorder Images",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
