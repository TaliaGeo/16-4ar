  "item": [
    {
      "name": "👤 Admin User Management",
      "item": [
        {
          "name": "Check Has Admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/users/has-admin",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "has-admin"]
            }
          }
        },
        {
          "name": "Create Admin (First Time Only)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newadmin@gharsih.com\",\n  \"password\": \"Admin@123\",\n  \"fullName\": \"مسؤول جديد\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/users/create-admin",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "create-admin"]
            }
          }
        },
        {
          "name": "Promote User to Admin",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users/2/promote",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "2", "promote"]
            }
          }
        },
        {
          "name": "Demote Admin",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users/2/demote",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "2", "demote"]
            }
          }
        }
      ]
    },
    {
      "name": "🌿 Plant CRUD",
      "item": [
        {
          "name": "Create Plant (Full)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set('plant_id', jsonData.id);",
                  "    console.log('Plant ID saved: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nameAr\": \"طماطم\",\n  \"nameEn\": \"Tomato\",\n  \"shortDescriptionAr\": \"خضار لذيذ ومفيد\",\n  \"shortDescriptionEn\": \"Delicious and healthy vegetable\",\n  \"category\": \"VEGETABLES\",\n  \"difficultyLevel\": \"EASY\",\n  \"wateringIntervalDays\": 2,\n  \"minTemp\": 18,\n  \"maxTemp\": 30,\n  \"daysToHarvest\": 90,\n  \"spacingCm\": 60,\n  \"germinationDays\": 7,\n  \"plantingStepsAr\": \"1. حضر التربة\\n2. ازرع البذور\\n3. اسقِ بانتظام\",\n  \"plantingStepsEn\": \"1. Prepare soil\\n2. Plant seeds\\n3. Water regularly\",\n  \"careInfoAr\": \"تحتاج لأشعة شمس كافية\",\n  \"careInfoEn\": \"Needs sufficient sunlight\",\n  \"harvestInfoAr\": \"احصد عندما تصبح حمراء\",\n  \"harvestInfoEn\": \"Harvest when red\",\n  \"wateringInfoAr\": \"اسقِ كل يومين\",\n  \"wateringInfoEn\": \"Water every 2 days\",\n  \"lightInfoAr\": \"شمس كاملة\",\n  \"lightInfoEn\": \"Full sun\",\n  \"soilInfoAr\": \"تربة خصبة جيدة الصرف\",\n  \"soilInfoEn\": \"Fertile well-draining soil\",\n  \"usesInfoAr\": \"سلطات، صلصات، عصائر\",\n  \"usesInfoEn\": \"Salads, sauces, juices\",\n  \"images\": [\n    {\n      \"imageUrl\": \"https://example.com/tomato1.jpg\",\n      \"altTextAr\": \"طماطم ناضجة\",\n      \"altTextEn\": \"Ripe tomato\",\n      \"isPrimary\": true\n    },\n    {\n      \"imageUrl\": \"https://example.com/tomato2.jpg\",\n      \"altTextAr\": \"شتلة طماطم\",\n      \"altTextEn\": \"Tomato seedling\",\n      \"isPrimary\": false\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/plants",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "plants"]
            }
          }
        },
        {
          "name": "Create Plant (Minimal)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
