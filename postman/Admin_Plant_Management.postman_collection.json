            },
            "url": {
              "raw": "{{base_url}}/api/admin/plants/{{plant_id}}/images/reorder",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "plants", "{{plant_id}}", "images", "reorder"]
            }
          }
        },
        {
          "name": "Delete Image",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
