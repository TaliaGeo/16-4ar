							"",
							"if (pm.response.code === 200) {",
							"    var json = pm.response.json();",
							"    var token = json.accessToken || json.token || json.access_token;",
							"    if (token) {",
							"        pm.collectionVariables.set('token', token);",
							"        console.log('✅ Token saved successfully');",
							"    }",
