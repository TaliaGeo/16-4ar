# ═══════════════════════════════════════════════════════════════════════
# Gharsih (غرسي) - Environment Variables
# قم بنسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# Copy this file to .env and adjust values for your environment
# ═══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/graduation_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME

# ── Email (Gmail SMTP) ───────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=gharsihapp@gmail.com
MAIL_PASSWORD=CHANGE_ME
EMAIL_FROM=gharsihapp@gmail.com
EMAIL_FROM_NAME=غرسي - Gharsih App
EMAIL_SUPPORT=gharsihapp@gmail.com

# ── JWT Security ─────────────────────────────────────────────────────
# MUST be at least 256 bits (32+ characters) for HMAC
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING_AT_LEAST_32_CHARS

# ── Admin Account ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@gharsih.ps
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=System Administrator

# ── OAuth2 ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ── Weather API (OpenWeatherMap) ─────────────────────────────────────
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
